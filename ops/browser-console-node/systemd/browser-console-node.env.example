# myrmidon(BROWSER-CONSOLE): screen-node environment template (part B).
#
# Copy to /etc/myrmidon/browser-console-node.env on the exec host, chmod
# root:root 0600. NEVER commit a filled-in copy — the token and the real
# operational address stay out of the repo.

# Required. Bearer token the board sends in Authorization; must equal
# MYRMIDON_BROWSER_CONSOLE_TOKEN on the board side. Generate:
#   openssl rand -hex 32
BROWSER_CONSOLE_NODE_TOKEN=change-me-32-hex

# Bind address: the exec-host operational interface the board reaches.
# Keep it a host address, not 0.0.0.0 — network policy must bound it too.
BROWSER_CONSOLE_NODE_BIND=exec-host.neutral.example
BROWSER_CONSOLE_NODE_PORT=8931

# x11vnc parameters (defaults shown; change only to match the stand).
BROWSER_CONSOLE_DISPLAY=:99
BROWSER_CONSOLE_VNC_PORT=5900

# The host guacd reaches for the picture (informational vnc:// endpoint in
# open(); matches MYRMIDON_BROWSER_VNC_TARGET on the board side).
BROWSER_CONSOLE_VNC_URL=exec-host.neutral.example

# CDP port of the live browser on this host.
BROWSER_CONSOLE_CDP_PORT=9222
