{
  "name": "@paperclipai/plugin-mail-imap",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "IMAP mail plugin: reads new messages from a company mailbox and sorts them into folders by configurable rules.",
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps",
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps && tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "mail",
    "imap",
    "automation"
  ],
  "author": "Paperclip",
  "license": "MIT",
  "dependencies": {
    "imapflow": "^1.0.198"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
