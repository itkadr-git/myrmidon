# Settings for scripts/myrmidon/deploy/{deploy,rollback}.sh. Copy it next to
# your compose files, fill in real values and keep it out of this repository.
# All values below are placeholders.

# Image repository; deploys always pin a digest. deploy.sh accepts only this
# value: only images built by CI are deployed, and there is no setting or flag
# that skips the check (registry, build commit on origin/main or a myr-v* tag).
# The check reads the git clone that holds these scripts, so run them from a
# clone of the repository whose `origin` is github.com/itkadr-git/myrmidon.
MYRMIDON_IMAGE=ghcr.io/itkadr-git/myrmidon

# Compose project: directory, main compose file(s) (colon-separated, relative
# to COMPOSE_DIR) and the server service. The scripts write the image line to
# COMPOSE_OVERRIDE_FILE and pass it after COMPOSE_FILES.
COMPOSE_DIR=/srv/example/myrmidon
COMPOSE_FILES=docker-compose.yml
COMPOSE_OVERRIDE_FILE=docker-compose.myrmidon-image.yml
COMPOSE_SERVICE=server

# Health endpoint as seen from the deploy host.
HEALTH_URL=http://127.0.0.1:3100/api/health
HEALTH_TIMEOUT_SEC=300
# In `authenticated` mode the version is visible only to signed-in callers:
# point this at a file (mode 0600) holding a board API key.
HEALTH_TOKEN_FILE=

# State (previous digest, history) and dumps.
STATE_DIR=/srv/example/myrmidon/.myrmidon-deploy
DUMP_DIR=/srv/example/backups/myrmidon

# Database dump before every deploy. The command runs with DUMP_FILE set and
# must write the dump there; an empty or missing file aborts the deploy.
DUMP_COMMAND='docker compose --project-directory /srv/example/myrmidon exec -T db pg_dump -U example -Fc example > "$DUMP_FILE"'
DUMP_MIN_BYTES=1024
# Used only by rollback.sh --restore-dump. Runs with DUMP_FILE set.
RESTORE_COMMAND='docker compose --project-directory /srv/example/myrmidon exec -T db pg_restore -U example -d example --clean --if-exists < "$DUMP_FILE"'

# Maintenance mode:
#   api   - POST/GET MAINTENANCE_API_URL (the R3 maintenance API, /api/myrmidon/maintenance)
#   hook  - run MAINTENANCE_ENTER_COMMAND / MAINTENANCE_EXIT_COMMAND
#   pause - no maintenance API yet: wait MAINTENANCE_PAUSE_SEC seconds
MAINTENANCE_MODE=pause
MAINTENANCE_API_URL=http://127.0.0.1:3100/api/myrmidon/maintenance
MAINTENANCE_TOKEN_FILE=
# What the window does when the drain timeout passes (api mode):
#   interrupt_and_retry - drain for MAINTENANCE_DRAIN_GRACE_SEC and then
#     interrupt the runs that are still going. Each interrupted run is marked
#     interrupted-by-maintenance and is retried automatically when the window
#     closes, so a planned deploy does not wait for long runs and no task is
#     left blocked.
#   wait - keep admission closed and wait out MAINTENANCE_DRAIN_TIMEOUT_SEC
#     (the behaviour before drain-interrupt).
MAINTENANCE_ON_TIMEOUT=interrupt_and_retry
MAINTENANCE_DRAIN_GRACE_SEC=300
# Only used with MAINTENANCE_ON_TIMEOUT=wait.
MAINTENANCE_DRAIN_TIMEOUT_SEC=1800
MAINTENANCE_ENTER_COMMAND=
MAINTENANCE_EXIT_COMMAND=
MAINTENANCE_PAUSE_SEC=0
# How long deploy.sh waits for the instance window to retire (state off)
# after the exit POST. The exit returns as soon as the server marks the window
# `leaving` (myrmidon EXIT-ASYNC): the wait below is on the STATE, not on the
# HTTP call. A timeout does not fail an already switched deploy; it is logged.
MAINTENANCE_EXIT_WAIT_SEC=120

# RELEASE-GATE (the 01.10 incident): the board and the release's component
# images (dockergate, fleetd) deploy together. deploy.sh resolves the
# component digests from the same release (the myr-vX.Y.Z tag, else the
# sha-<short> tag of the commit) and refuses a release whose components are
# missing from the registry. Set to none to deploy the board alone (NOT
# recommended for a release; the incident was exactly that split).
MYRMIDON_RELEASE_COMPONENTS=dockergate,fleetd

# Per-component settings. Service and override file default to the component
# name and docker-compose.myrmidon-<component>.yml; override per component:
#   MYR_DOCKERGATE_COMPOSE_SERVICE / MYR_DOCKERGATE_OVERRIDE_FILE
#   MYR_FLEETD_COMPOSE_SERVICE     / MYR_FLEETD_OVERRIDE_FILE
# fleetd: the health URL is REQUIRED; the deploy must prove the component
# answers after its switch, not just that the file was written (the rollout
# refuses before it pulls anything when it is missing). fleetd serves /v1/bots
# with a bearer token; a probe of /v1/bots with the token file answers 200 only
# when the service is up:
#   MYR_FLEETD_HEALTH_URL='http://127.0.0.1:8080/v1/bots -H "Authorization: Bearer ***"'
# The value is passed to curl verbatim after the URL, so extra curl arguments
# ride along; quotes keep it one word in the settings file.
# dockergate: NO health URL. Its engine socket answers only the board's main
# process (the host gets 403 caller_not_board_main), so a ping from the host,
# for example `curl --unix-socket /run/myrmidon-dockergate/engine.sock
# http://localhost/_ping`, can never pass and a healthy dockergate was once
# declared dead by it. dockergate is proven by what it logs: the container runs
# and its newest "self-check ok" / "config_reloaded" line reports the version of
# the new binary and the hash of the config it loaded. MYR_DOCKERGATE_HEALTH_URL
# is ignored (with a note). The log is read from the compose service; if
# dockergate's log lives elsewhere, DOCKERGATE_LOGS_COMMAND (below) prints it.
MYR_DOCKERGATE_HEALTH_URL=
MYR_FLEETD_HEALTH_URL=

# One source of truth per component image: the generated override file
# (docker-compose.myrmidon-<component>.yml next to the compose files) is what the
# deploy writes, what the rollback restores and what the boot unit reads. The
# "previous" image of a component is the image of the container that runs
# (docker inspect), never a file. The canonical boot unit (paperclip.service)
# lists the override files of the local release components; a unit from before
# that change is replaced by the canonical one when SYSTEMD_UNIT_INSTALL=1 (below),
# any other unit is refused.

# Where each component actually runs (the 02.10 two-host follow-up): a component does
# not have to live on the deploy host. Values:
#   local (default)    the service runs in this host's compose project; the
#                      rollout proves it first (docker compose config
#                      --services) and refuses BEFORE pulling or writing
#                      anything when the service is not part of the project
#                      (fail-closed).
#   remote:<user>@<host>  the service runs on another host (fleetd of the
#                      1.4.0 production install lives on the second host):
#                      docker/compose run through ssh (key auth, no password
#                      prompt), the override file is written there under the
#                      same relative path, the health URL is probed FROM THE
#                      DEPLOY HOST (give the address the deploy host reaches).
#   skip               the component is not managed by this deploy at all
#                      (its own procedure rolls it out elsewhere); the
#                      rollout logs a loud SKIP and the CI-image check still
#                      runs: the release must name a real component image.
#   Example: MYR_FLEETD_HOST=remote:root@vm-exec
MYR_DOCKERGATE_HOST=local
MYR_FLEETD_HOST=local

# Post-deploy smoke (RELEASE-GATE): after the deploy, within the timeout at
# least one bot container of this company must re-apply (its container is
# running again); otherwise the deploy reports DEGRADED with the rollback
# commands. Empty company disables the smoke with a warning (not for a
# release: the smoke is the whole point).
MYRMIDON_DEPLOY_SMOKE=1
MYRMIDON_DEPLOY_SMOKE_COMPANY=
MYRMIDON_DEPLOY_SMOKE_AGENT=
MYRMIDON_DEPLOY_SMOKE_TIMEOUT_SEC=300
MYRMIDON_DEPLOY_SMOKE_INTERVAL_SEC=10

# Bot image rollout (BOT-IMAGE-ROLLOUT, 1.6.1): the hermes/hermes-dev/
# hermes-node images of the release roll out together with the board — the
# digests resolve from the same tag/sha, land in dockergate's allowed images,
# the fleet enrolls in bots[] (no more bot_not_enrolled), and every bot card
# switches one at a time (canary first, deferred bots retried, a run is never
# interrupted). 0 restores the manual path and the deploy warns.
MYRMIDON_BOT_IMAGE_ROLLOUT=1
# The agent id that switches first (canary). Empty = plain order.
MYRMIDON_BOT_IMAGE_ROLLOUT_CANARY=
# How long one deferred bot is retried before its card keeps the old image
# (the periodic sweep applies the release image later anyway).
MYRMIDON_BOT_IMAGE_ROLLOUT_BOT_TIMEOUT_SEC=900
# The dockergate config.json this rollout edits (images[] and bots[]).
# Structural jq edits, verified by check-config when the command below is set.
MYRMIDON_BOT_IMAGE_ROLLOUT_DOCKERGATE_CONFIG=
# check-config against the real binary; $MYR_BOT_CFG_FILE names the edited
# file. Example:
#   MYRMIDON_BOT_IMAGE_ROLLOUT_DOCKERGATE_CHECK_CONFIG_COMMAND='docker exec dockergate /dockergate check-config --config '"$MYR_BOT_CFG_FILE"''
# or, when the config is bind-mounted at the same path inside the container:
#   'docker run --rm -v '"$MYR_BOT_CFG_FILE"':/c.json:ro ghcr.io/itkadr-git/myrmidon-dockergate check-config --config /c.json'
MYRMIDON_BOT_IMAGE_ROLLOUT_DOCKERGATE_CHECK_CONFIG_COMMAND=
# How dockergate is told to re-read its config (SIGHUP). Example:
#   MYRMIDON_BOT_IMAGE_ROLLOUT_DOCKERGATE_SIGNAL_COMMAND='docker exec dockergate kill -HUP 1'
MYRMIDON_BOT_IMAGE_ROLLOUT_DOCKERGATE_SIGNAL_COMMAND=
# After the signal the rollout proves dockergate loaded the new file: the hash of
# the file (first 12 hex digits of its sha256) must appear in dockergate's log
# (the "config_reloaded" line); otherwise the deploy fails loudly - a reload that
# fails (for example a file dockergate's user cannot read) leaves the old config
# in memory. Seconds to wait for it (default 30).
MYRMIDON_BOT_IMAGE_ROLLOUT_DOCKERGATE_RELOAD_TIMEOUT_SEC=30
# Fleet hosts the bots live on (remote:<user>@<host>, comma-separated; the
# same shape as MYR_<COMPONENT>_HOST). The rollout pulls the bot images and
# enrolls the fleet's bots[] there too.
MYRMIDON_BOT_IMAGE_ROLLOUT_FLEET_HOSTS=
# fleetd config.json on a fleet host (default /etc/myrmidon-fleetd/config.json).
MYRMIDON_BOT_IMAGE_ROLLOUT_FLEET_CONFIG=
# Where the rollout journal is written (default STATE_DIR/bot-image-rollout.log):
# a line per switch, "UTC agent-id old-image -> new-image (outcome)".
MYRMIDON_BOT_IMAGE_ROLLOUT_LOG=
# ONE-DEPLOY: bot cards switch in batches of at most 5 (hard cap), each bot only
# while its agent is paused or idle. A summary is written to
# STATE_DIR/bot-image-rollout-summary.json.
MYRMIDON_BOT_IMAGE_ROLLOUT_BATCH_SIZE=5
# ONE-DEPLOY: a component failure inside the deploy window rolls the changed
# components, the dockergate config and the board back together (1, default).
# 0 keeps the manual contract: maintenance stays on, the rollback commands are
# printed.
MYRMIDON_COMPONENT_AUTO_ROLLBACK=1
# ONE-DEPLOY: deploy.sh --release myr-vX.Y.Z reads the component digests from
# the release asset release-components.json. An offline copy of that file:
MYRMIDON_RELEASE_MANIFEST_FILE=

# --- PREDEPLOY-DB-CHECK (the 05.10 incident) --------------------------------
# Release 1.6.3's board image started fine on the CI database (empty) and
# crashed at startup on production DATA (an attention card whose key was not a
# uuid). It surfaced inside the maintenance window, the fleet stood still and
# the board had to be rolled back by hand.
#
# Before the window deploy.sh now restores the predeploy dump into a THROWAWAY
# Postgres, starts the new board there next to the NEW dockergate of the same
# release (the 1.6.3 board never became `ok` against the old dockergate,
# `route_not_allowed`), waits for /api/health `status: ok` with the version and
# commit of the new image, and walks the attention list and the main company
# routes. Any failure stops the deploy BEFORE the window: production is never
# touched. The whole stack is removed on exit.
#
# Everything below is REQUIRED while the check is on (1, the default): the check
# refuses and nothing changes. Set it to 0 only to deploy an image that nothing
# proved against production data, and read the warning it logs.
MYRMIDON_PREDEPLOY_CHECK=1
# The Postgres image of the throwaway database. Its major version must be able
# to read the predeploy dump (pg_restore refuses an older server).
MYRMIDON_PREDEPLOY_POSTGRES_IMAGE=postgres:16-alpine
# Database and role created inside the throwaway Postgres. The predeploy dump is
# restored into it; no production credential is involved (the copy's password is
# generated per run).
MYRMIDON_PREDEPLOY_DB_NAME=myrmidon
MYRMIDON_PREDEPLOY_DB_USER=myrmidon
# Waits for the copy to accept connections. Runs with MYR_PREDEPLOY_DB_CONTAINER,
# MYR_PREDEPLOY_DB_USER, MYR_PREDEPLOY_DB_NAME, MYR_PREDEPLOY_DB_PASSWORD set;
# exit 0 = ready. Default shown; override for a non-standard image.
MYRMIDON_PREDEPLOY_DB_READY_COMMAND=
# Restores the predeploy dump ($DUMP_FILE) into the copy. Same environment as
# above, plus DUMP_FILE. Default (for the `-Fc` dump of DUMP_COMMAND):
#   docker exec -i -e PGPASSWORD="$MYR_PREDEPLOY_DB_PASSWORD" "$MYR_PREDEPLOY_DB_CONTAINER" pg_restore -U "$MYR_PREDEPLOY_DB_USER" -d "$MYR_PREDEPLOY_DB_NAME" --no-owner < "$DUMP_FILE"
MYRMIDON_PREDEPLOY_RESTORE_COMMAND=
# The board's own environment (KEY=VALUE lines, like an --env-file): the throwaway
# board must start like the production board (secrets, adapter tokens, ...).
# Its DATABASE_URL is IGNORED on purpose — the copy's URL is set by the check, so
# the throwaway board cannot reach the production database. Set
# MYRMIDON_BOT_DOCKER_SOCKET here to the same path the production board uses, so
# the throwaway board talks to the throwaway dockergate.
MYRMIDON_PREDEPLOY_BOARD_ENV_FILE=
# Optional extra `docker run` arguments: the socket directory and the config of
# the throwaway dockergate (it must accept the throwaway board as its caller —
# a config whose caller mode is `uid` is the usual answer; see
# docs/myrmidon/dockergate.md), and the mount of that socket into the board.
# Example: MYRMIDON_PREDEPLOY_DOCKERGATE_ARGS='-v /srv/example/predeploy-dg:/run/myrmidon-dockergate -v /srv/example/predeploy-dockergate.json:/c.json:ro'
#          MYRMIDON_PREDEPLOY_BOARD_ARGS='-v /srv/example/predeploy-dg:/run/myrmidon-dockergate'
MYRMIDON_PREDEPLOY_DOCKERGATE_ARGS=
MYRMIDON_PREDEPLOY_BOARD_ARGS=
MYRMIDON_PREDEPLOY_DOCKERGATE_ENV_FILE=
# Port the throwaway board publishes on 127.0.0.1 (free on the deploy host).
MYRMIDON_PREDEPLOY_BOARD_PORT=13110
# Docker network of the throwaway stack. Default: myr-predeploy-<digest>-<pid>.
# Neither the bots nor the production dockergate are on it.
MYRMIDON_PREDEPLOY_NETWORK=
# How long the check waits for the throwaway board / database. Defaults to
# HEALTH_TIMEOUT_SEC.
MYRMIDON_PREDEPLOY_HEALTH_TIMEOUT_SEC=
# Routes walked against the copy, comma-separated; :company: expands to
# BOARD_COMPANY_ID. The attention list is the route whose data broke 1.6.3 and
# is walked by default. With no token configured a 401/
# 403 is a warning (the route was reached, the data path was not exercised); a
# 5xx or an unreachable route is always a failure.
MYRMIDON_PREDEPLOY_API_PATHS=
# Board API key file for the walk. Defaults to HEALTH_TOKEN_FILE, then
# BOARD_TOKEN_FILE. With a token configured, 401/403 is a failure.
MYRMIDON_PREDEPLOY_TOKEN_FILE=
# 1 keeps the throwaway stack and prints the container names (debugging).
MYRMIDON_PREDEPLOY_KEEP=0

# Host executor for deploys started from the board interface (R5-A).
# deploy-from-job.sh polls the board, waits for the maintenance window and
# runs deploy.sh for the job digest, reporting the outcome as
# $STATE_DIR/job-<id>.json (mount that directory read-only into the board
# container as MYRMIDON_DEPLOY_REPORTS_DIR). A board API key file is required
# in `authenticated` mode; the same file as HEALTH_TOKEN_FILE works.
BOARD_API_URL=http://127.0.0.1:3100/api
BOARD_TOKEN_FILE=
# Post-deploy fleet check (myrmidon POST-DEPLOY-CHECK): with BOARD_API_URL and
# BOARD_COMPANY_ID both set, deploy.sh verifies that no issue became blocked in
# the deploy window and that the maintenance window retired; without them the
# check is skipped with a log line — set both for a release deploy. The check
# reads "$BOARD_API_URL/companies/$BOARD_COMPANY_ID/issues?status=blocked&...",
# so BOARD_API_URL is the API root WITH the /api suffix; BOARD_COMPANY_ID is
# the company UUID the fleet works for (the same one the post-deploy smoke's
# MYRMIDON_DEPLOY_SMOKE_COMPANY names).
BOARD_COMPANY_ID=00000000-0000-4000-8000-000000000000

# Automatic rollback by health (R5-C). When a deploy started from the board
# fails its health check, the executor immediately runs rollback.sh to the
# image deploy.sh remembered before the switch (the locally known previous
# image) and reports rolled-back / rollback-failed to the board. 1 is the
# default; 0 keeps the manual contract (health-failed, the maintenance window
# stays on, the operator rolls back by hand). The board side of the same
# switch is MYRMIDON_DEPLOY_AUTO_ROLLBACK; both must agree for a consistent
# job view.
AUTO_ROLLBACK=1

# How to count runs in progress. Empty with MAINTENANCE_MODE=api: read
# instance.runningRuns from the maintenance API. Must print a number.
RUNNING_RUNS_COMMAND=
RUNS_WAIT_TIMEOUT_SEC=1800
POLL_INTERVAL_SEC=5

# --- One boot path -----------------------------------------------
# The systemd unit that starts the board at boot. deploy.sh verifies before
# anything changes that the unit starts the server from exactly COMPOSE_DIR,
# COMPOSE_FILES and the override this deploy manages (the 01.10 incident was
# a unit reading a vendor compose file). A unit that differs is a refusal.
# SYSTEMD_UNIT_DIR lets a stand/test installation point at a sandbox.
# SYSTEMD_UNIT_INSTALL=1 installs the canonical unit from
# scripts/myrmidon/deploy/paperclip.service.template when none exists yet
# (needs root); an existing foreign unit is NEVER overwritten automatically.
SYSTEMD_UNIT_NAME=paperclip.service
SYSTEMD_UNIT_DIR=/etc/systemd/system
# With SYSTEMD_UNIT_INSTALL=1 the previous canonical unit (before the component
# override files joined the compose file list) is also replaced by the current one.
SYSTEMD_UNIT_INSTALL=

# --- Post-boot check ---------------------------------------------
# post-boot-check.sh runs after docker, the board and nginx (systemd unit
# myrmidon-post-boot.service, installed from the template in the same
# directory). Every URL left empty switches its check off with a log line;
# the defaults below are the production set of vm-core.
# DOCKERGATE_EXPECT_IMAGE: the dockergate image the release recorded (empty =
# no dockergate in this release, the check is off).
# DOCKERGATE_LOGS_COMMAND: prints the dockergate log since boot; the check
# greps it for deny lines and must print a number of them (0 expected). The
# deploy reads the same log to prove dockergate's version and config hash.
# DNS_CHECK_NETWORK: the docker network the name resolution check uses;
# DNS_CHECK_NAMES: the names other services use (default below).
NGINX_CHECK_URL=http://127.0.0.1/
LITELLM_CHECK_URL=
RAGFLOW_CHECK_URL=
HINDSIGHT_CHECK_URL=
DOCKERGATE_EXPECT_IMAGE=
DOCKERGATE_LOGS_COMMAND=
DNS_CHECK_NETWORK=myrmidon
DNS_CHECK_NAMES=mysql es01 paperclip-server-1
DNS_CHECK_IMAGE=busybox:latest

# LLM tracing (TRACING-HEALTH). Langfuse v4 in events_only mode rejects the
# legacy /api/public/ingestion endpoint; LiteLLM sends to it for as long as the
# legacy `langfuse` callback is enabled, which is about 12k rejected events per
# hour and burned gateway CPU while nothing checked tracing. Tracing therefore
# runs over OTLP only and deploy.sh verifies the callback set (7b/8,
# tracing-check.sh). A refusal fails the deploy and cannot be skipped. All of
# the settings below are optional: without any of them the check logs a skip.
#
# Base URL of the Langfuse server. The public route /api/public/health carries
# the version (the v4 marker); the probe needs no credentials.
MYRMIDON_TRACING_LANGFUSE_URL=
# Version pinned in the bundle; the fallback when the health route is
# unreachable or answers without a version (an unproven version is treated as
# v4 for a legacy callback). Not the same as the Langfuse image tag.
MYRMIDON_TRACING_LANGFUSE_VERSION=
# The deployed LiteLLM config file. Its `callbacks:` list under
# `litellm_settings:` is read as one of the effective sources.
MYRMIDON_TRACING_GATEWAY_CONFIG=
# Command printing the effective callbacks of the live gateway (or its
# database), one per line or comma/space separated. Read together with the
# config file, because the config file and the gateway database disagree and
# the database only adds callbacks.
MYRMIDON_TRACING_CALLBACKS_COMMAND=
# Generated file with the callback list the bundle installs (one source of
# truth, written from tracing_intended_callbacks() in lib.sh). Default:
# $STATE_DIR/tracing-callbacks.txt.
MYRMIDON_TRACING_CALLBACKS_FILE=
# Token file for a guarded health route (a Langfuse deployment behind auth).
MYRMIDON_TRACING_TOKEN_FILE=
# Command printing two integers for the delivery window — the OTEL event count
# in `events_core` (ClickHouse) and the LiteLLM SpendLogs request count. The
# installer sends a test request and waits for an event: without it the install
# is NOT complete, so zero events with traffic is refused. The check also
# refuses a delivery ratio below 50% and unreadable counts. The window is
# exported to the command as MYRMIDON_TRACING_DELIVERY_WINDOW_SEC.
MYRMIDON_TRACING_DELIVERY_COMMAND=
# The window those two counts cover, in seconds. 900 (15 min) by default.
MYRMIDON_TRACING_DELIVERY_WINDOW_SEC=900
# Image references of the bundle, checked for a full version pin: a major or
# minor tag (for example `langfuse/langfuse:4`) moves under the deployment and
# is refused. Use X.Y.Z or a digest. Unset — the pin check is skipped.
MYRMIDON_TRACING_LANGFUSE_IMAGE=
MYRMIDON_TRACING_GATEWAY_IMAGE=
