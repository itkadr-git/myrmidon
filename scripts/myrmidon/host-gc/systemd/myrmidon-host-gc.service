[Unit]
Description=Myrmidon Host GC — Task Clone & Build Cache Cleanup
Documentation=file:///opt/myrmidon/scripts/myrmidon/host-gc/README.md
After=local-fs.target network.target

[Service]
Type=oneshot
Environment=PAPERCLIP_API_URL=http://127.0.0.1:3100
ExecStart=/usr/bin/node /opt/myrmidon/scripts/myrmidon/host-gc/host-clone-cache-gc.mjs --apply
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
