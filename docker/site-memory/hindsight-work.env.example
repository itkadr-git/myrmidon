# The profile file profile/hindsight-work.env. Placeholders only: the values come from the site
# profile (llmBaseUrl) and the company secrets.
HINDSIGHT_API_DATABASE_URL=postgresql://<hs-pg user>:<hs-pg password>@hs-pg:5432/<hs-pg db>
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=<site profile llmBaseUrl>/v1
HINDSIGHT_API_LLM_MODEL=<memory model id on the gateway>
HINDSIGHT_API_LLM_API_KEY=<gateway key for the site>
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=<site profile llmBaseUrl>/v1
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=<embedding model id on the gateway>
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=<gateway key for the site>
HINDSIGHT_API_LOG_LEVEL=info
