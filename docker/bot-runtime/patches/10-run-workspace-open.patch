         return profile_prefix_middleware

+    async def _handle_offline_workspace(self, request):
+        # Only the gateway master key; run-scoped keys must not reserve paths.
+        if _api_request_profile.get() not in (None, "default") or not self._api_key:
+            return self._auth_failed_response()
+        auth_err = self._check_auth(request)
+        if auth_err is not None:
+            return auth_err
+        from tools.run_workspace import offline_workspace_identity, reserve_offline_workspace
