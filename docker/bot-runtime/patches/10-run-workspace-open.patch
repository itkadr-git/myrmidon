diff --git a/tools/run_workspace.py b/tools/run_workspace.py
new file mode 100644
index 0000000..360e518
--- /dev/null
+++ b/tools/run_workspace.py
@@ -0,0 +1,321 @@
+"""Run-scoped task workspace resolution via ``myr-ws open`` (myrmidon BOT-DISK-H5b).
+
+The board's hermes_gateway adapter may attach a ``workspace`` field to a
+``/v1/runs`` request (contract C6 of the bot-disk contract): a task key, an
+``owner/repo`` pair and an optional base ref. Before the model starts, the
+gateway then opens (or reuses) the task copy through the image's ``myr-ws``
+CLI::
+
+    myr-ws open <key> <repo> [--base <baseRef>] [--branch <branch>] --json
+
+On success the run's cwd is the opened copy (``/workspace/<key>``) and its
+terminal children see ``MYRMIDON_TASK_WORKSPACE`` pointing at it. Exit codes
+(quota refusal, base limit, network) and every other open failure (any other
+exit code, timeout, undecodable output) never fail the run: it starts in
+the fallback directory ``/scratch`` instead and the run stream carries a
+warning event — a silent failure would send the agent's edits to the wrong
+directory, and a failed run would count against the agent's health.
+A request without the field behaves exactly as before.
+
+Concurrency: the resolved path lives in a ContextVar bound in
+``_run_agent_sync`` (the run's executor thread), never in the process env —
+a gateway process serves many concurrent runs that share ``os.environ``.
+``tools/environments/local.py`` bridges the bound value into child-process
+envs at spawn time, so each run's children see only their own path.
+
+The binary is overridable for tests through ``MYRMIDON_WS_BIN``; the runner
+module is otherwise a thin, dependency-free subprocess wrapper so the
+build-time behaviour test can exercise it with a fake ``myr-ws`` script.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import shutil
+import subprocess
+from contextvars import ContextVar, Token
+from typing import Any, Dict, Optional
+
+logger = logging.getLogger(__name__)
+
+# Contract C6 (packages/shared/src/myrmidon-bot-workspace.ts in the board repo):
+# exit codes 3/4/5 fall back to RUN_WORKSPACE_FALLBACK_DIR with a warning
+# event. So does every other open failure (other exit code, timeout,
+# bad output) — an unopenable workspace is a turn error, never a reason to fail
+# the run and flip the agent to status error. The warning carries the cause.
+RUN_WORKSPACE_FALLBACK_DIR = "/scratch"
+MYR_WS_OPEN_TIMEOUT_SEC = 120
+_TIMEOUT_EXIT_CODE = 124
+_TASK_WORKSPACE_ENV = "MYRMIDON_TASK_WORKSPACE"
+
+# (path, is_fallback) for the current run context, or None when the request
+# carried no ``workspace`` field (today's behaviour).
+_TASK_WORKSPACE: ContextVar = ContextVar("MYRMIDON_RUN_TASK_WORKSPACE", default=None)
+
+
+def set_run_task_workspace(path: str, *, fallback: bool) -> Token:
+    """Bind the resolved workspace path for the current run context."""
+    return _TASK_WORKSPACE.set((path, bool(fallback)))
+
+
+def reset_run_task_workspace(token: Token) -> None:
+    _TASK_WORKSPACE.reset(token)
+
+
+def run_task_workspace_env() -> Dict[str, str]:
+    """The child-process env fragment for the bound workspace, or ``{}``."""
+    bound = _TASK_WORKSPACE.get()
+    if bound is None:
+        return {}
+    return {_TASK_WORKSPACE_ENV: bound[0]}
+
+
+def run_task_workspace_path() -> Optional[str]:
+    """The bound workspace path (or fallback dir), or None when unbound."""
+    bound = _TASK_WORKSPACE.get()
+    return None if bound is None else bound[0]
+
+
+def task_workspace_env_name() -> str:
+    return _TASK_WORKSPACE_ENV
+
+
+def _offline_volume():
+    import re
+    from pathlib import Path
+
+    home = Path(os.path.realpath("/data/hermes"))
+    bot = os.environ.get("MYRMIDON_BOT_KEY", "")
+    roots = {Path("/data/hermes"): "/data/hermes", Path("/bot/hermes"): "/bot",
+             Path("/bot-scope") / bot / "hermes": "/bot-scope"}
+    if home not in roots:
+        raise ValueError("Offline workspace requires a managed bot volume")
+    mounts = {}
+    with open("/proc/self/mountinfo", encoding="utf-8") as stream:
+        for line in stream:
+            before, after = line.strip().split(" - ", 1)
+            fields = before.split()
+            target = re.sub(r"\\([0-7]{3})", lambda m: chr(int(m[1], 8)), fields[4])
+            mounts[target] = [fields[2], fields[3], *after.split()[:2]]
+    root = roots[home]
+    if root not in mounts:
+        raise ValueError("Persistent bot volume is not mounted")
+    return home, [root, mounts[root], sorted(m for m in mounts if m.startswith(str(home / "offline-workspaces") + "/") or m == str(home / "offline-workspaces"))]
+
+
+def offline_workspace_path(home, company, issue):
+    import re
+
+    for value in (company, issue):
+        if not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}", value):
+            raise ValueError("Offline workspace requires canonical UUIDs")
+    return home / "offline-workspaces" / company / issue
+
+
+def reserve_offline_workspace(company, issue):
+    import stat
+
+    home, volume = _offline_volume()
+    cwd = offline_workspace_path(home, company, issue)
+    for directory in (cwd.parent.parent, cwd.parent, cwd):
+        _reject_nested_mount(directory, volume, descendants=False)
+        directory.mkdir(mode=0o700, exist_ok=True)
+        st = directory.lstat()
+        if (not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid() or st.st_gid != os.getegid()
+                or st.st_dev != home.stat().st_dev or stat.S_IMODE(st.st_mode) != 0o700):
+            raise ValueError("Offline workspace reservation is not a private directory")
+    return cwd
+
+
+def _reject_nested_mount(cwd, volume, descendants=True):
+    from pathlib import Path
+
+    if any(cwd.is_relative_to(m) or (descendants and m.is_relative_to(cwd))
+           for m in map(Path, volume[2])):
+        raise ValueError("Offline workspace contains a nested mount")
+
+
+def _require_local_git_checkout(cwd):
+    # Do not inherit Git overrides or allow transports (including promisor fetches).
+    env = {"PATH": "/usr/bin:/bin", "LC_ALL": "C", "GIT_CONFIG_NOSYSTEM": "1",
+           "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_ALLOW_PROTOCOL": "",
+           "GIT_NO_LAZY_FETCH": "1", "GIT_NO_REPLACE_OBJECTS": "1",
+           "GIT_CEILING_DIRECTORIES": str(cwd.parent)}
+
+    def local_git(*args):
+        return subprocess.run(["/usr/bin/git", "-C", str(cwd), *args],
+                              env=env, check=True, capture_output=True, timeout=3).stdout
+
+    try:
+        if (local_git("rev-parse", "--is-inside-work-tree", "--show-toplevel", "--absolute-git-dir").splitlines()
+                != [b"true", os.fsencode(cwd), os.fsencode(cwd / ".git")]):
+            raise ValueError("Offline workspace is not the root of a standalone working tree")
+        local_git("rev-parse", "--verify", "HEAD^{commit}")
+    except (OSError, subprocess.SubprocessError) as exc:
+        raise ValueError("Offline workspace requires a locally available HEAD commit") from exc
+
+
+def offline_workspace_identity(company, issue):
+    import hashlib
+    import stat
+
+    home, volume = _offline_volume()
+    cwd = offline_workspace_path(home, company, issue)
+    if cwd.resolve(strict=True) != cwd:
+        raise ValueError("Offline workspace path must be canonical")
+    _reject_nested_mount(cwd, volume)
+    facts = []
+    for directory in (home, cwd.parent.parent, cwd.parent, cwd, cwd / ".git", cwd / ".git/objects"):
+        st = directory.lstat()
+        if (not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid() or st.st_gid != os.getegid()
+                or st.st_dev != home.stat().st_dev or st.st_mode & 0o022):
+            raise ValueError("Offline workspace has an unexpected owner, mode or device")
+        facts.append([st.st_dev, st.st_ino, st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode)])
+    git = cwd / ".git"
+    if (stat.S_IMODE(cwd.stat().st_mode) != 0o700 or not stat.S_ISREG((git / "HEAD").lstat().st_mode)
+            or any(os.path.lexists(git / ref) for ref in ("commondir", "objects/info/alternates", "objects/info/http-alternates"))):
+        raise ValueError("Offline workspace requires a private standalone Git directory")
+    _require_local_git_checkout(cwd)
+    fingerprint = hashlib.sha256(json.dumps([str(cwd), volume[:2], facts]).encode()).hexdigest()
+    return {"cwd": str(cwd), "fingerprint": fingerprint, "physicalId": f"{facts[3][0]}:{facts[3][1]}"}
+
+
+def offline_workspace_fingerprint(company, issue):
+    return offline_workspace_identity(company, issue)["fingerprint"]
+
+
+def _validate_workspace_field(field: Any) -> Dict[str, str]:
+    """Shape-check the ``workspace`` body field (C6 ``runWorkspaceFieldSchema``).
+
+    Mirrors the zod schema: ``key`` an issue key (``PREFIX-123``), ``repo``
+    ``owner/name``, optional ``baseRef`` a plausible git ref. Raises
+    ValueError on any mismatch — the field is machine-generated by the board,
+    so a malformed one means an adapter bug, not user input to be lenient
+    about.
+    """
+    import re
+
+    if not isinstance(field, dict):
+        raise ValueError("workspace must be an object with key/repo[/baseRef]")
+    offline = {"offlineCompanyId", "offlineIssueId", "offlineBotId", "offlineFingerprint", "offlineWorkspaceId", "offlineCwd"}
+    if offline.intersection(field):
+        if set(field) != offline:
+            raise ValueError("Invalid offline workspace fields")
+        for key in offline:
+            if key == "offlineCwd":
+                if not isinstance(field[key], str) or not field[key].startswith("/"):
+                    raise ValueError("Invalid offline workspace cwd")
+                continue
+            pattern = r"[a-f0-9]{64}" if key == "offlineFingerprint" else r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}"
+            if not isinstance(field[key], str) or not re.fullmatch(pattern, field[key]):
+                raise ValueError("Invalid offline workspace identity")
+        return dict(field)
+    key = field.get("key")
+    repo = field.get("repo")
+    base_ref = field.get("baseRef")
+    branch = field.get("branch")
+    if not (isinstance(key, str) and re.fullmatch(r"[A-Z][A-Z0-9]*-[0-9]+", key)):
+        raise ValueError("workspace.key must look like PREFIX-123")
+    if not (isinstance(repo, str) and re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repo)):
+        raise ValueError("workspace.repo must be owner/name")
+    if base_ref is not None:
+        if not (isinstance(base_ref, str) and 0 < len(base_ref) <= 200
+                and re.fullmatch(r"[^\s~^:?*\[\\]+", base_ref)):
+            raise ValueError("workspace.baseRef is not a valid git ref")
+        base_ref = base_ref.strip()
+        if not base_ref:
+            raise ValueError("workspace.baseRef is not a valid git ref")
+    if branch is not None:
+        if not (isinstance(branch, str) and 0 < len(branch) <= 200
+                and re.fullmatch(r"[^\s~^:?*\[\\]+", branch)
+                and not branch.startswith("-") and ".." not in branch):
+            raise ValueError("workspace.branch is not a valid git branch")
+    out = {"key": key, "repo": repo}
+    if base_ref:
+        out["baseRef"] = base_ref
+    if branch:
+        out["branch"] = branch
+    return out
+
+
+def _myr_ws_bin() -> str:
+    return os.environ.get("MYRMIDON_WS_BIN") or "myr-ws"
+
+
+def _fallback(exit_code: int, error: str) -> Dict[str, Any]:
+    logger.warning("myr-ws open failed (exit %s), run falls back to %s: %s",
+                   exit_code, RUN_WORKSPACE_FALLBACK_DIR, error)
+    return {"path": RUN_WORKSPACE_FALLBACK_DIR, "fallback": True,
+            "exit_code": exit_code, "error": error}
+
+
+def open_task_workspace(field: Dict[str, Any]) -> Dict[str, Any]:
+    """Run ``myr-ws open`` for a validated workspace field.
+
+    Returns ``{"path": <dir>, "fallback": bool, "exit_code": int,
+    "error": str}``. ``fallback`` is True for contract exit codes 3/4/5:
+    ``path`` is then the fallback dir and the caller must surface ``error``
+    as a run warning. Never raises for an open failure (any exit code, timeout,
+    missing binary, undecodable output): the run starts in the fallback dir.
+    """
+    ws = _validate_workspace_field(field)
+    if "offlineCompanyId" in ws:
+        if os.environ.get("MYRMIDON_BOT_KEY") != ws["offlineBotId"]:
+            raise ValueError("Offline workspace belongs to a different bot")
+        company, issue = ws["offlineCompanyId"], ws["offlineIssueId"]
+        identity = offline_workspace_identity(company, issue)
+        if identity["fingerprint"] != ws["offlineFingerprint"] or identity["cwd"] != ws["offlineCwd"]:
+            raise ValueError("Offline workspace identity changed")
+        return {"path": identity["cwd"],
+                "fallback": False, "exit_code": 0, "error": "", "recovered": []}
+    argv = [_myr_ws_bin(), "open", ws["key"], ws["repo"]]
+    if ws.get("baseRef"):
+        argv += ["--base", ws["baseRef"]]
+    if ws.get("branch"):
+        argv += ["--branch", ws["branch"]]
+    argv.append("--json")
+    binary = argv[0]
+    if shutil.which(binary) is None and not os.path.isfile(binary):
+        # No CLI in this image at all: the field cannot be honoured. Contract
+        # treats that like the refusal family — fall back with a warning
+        # rather than fail every run on a host where myr-ws is absent.
+        return {
+            "path": RUN_WORKSPACE_FALLBACK_DIR, "fallback": True, "exit_code": 3,
+            "error": f"myr-ws binary not found ({binary}); running in {RUN_WORKSPACE_FALLBACK_DIR}",
+        }
+    try:
+        proc = subprocess.run(
+            argv, capture_output=True, text=True, timeout=MYR_WS_OPEN_TIMEOUT_SEC)
+    except subprocess.TimeoutExpired:
+        return _fallback(
+            _TIMEOUT_EXIT_CODE,
+            f"myr-ws open timed out after {MYR_WS_OPEN_TIMEOUT_SEC}s for {ws['key']}")
+    except OSError as exc:
+        return _fallback(1, f"myr-ws open could not start for {ws['key']}: {exc}")
+    stdout = (proc.stdout or "").strip()
+    parsed: Dict[str, Any] = {}
+    if stdout:
+        try:
+            parsed = json.loads(stdout.splitlines()[-1])
+        except (ValueError, IndexError):
+            parsed = {}
+    if proc.returncode == 0:
+        path = parsed.get("path") if isinstance(parsed, dict) else None
+        if not (isinstance(path, str) and path):
+            return _fallback(
+                1, f"myr-ws open {ws['key']} exited 0 without a JSON path: {stdout[:200]!r}")
+        recovered = parsed.get("recovered") if isinstance(parsed, dict) else None
+        if recovered:
+            # myr-ws found the copy left half-way (merge/rebase in progress, ...) and repaired it;
+            # the state is in the recovery ref it names. Not a failure: log it for the operator.
+            logger.warning("myr-ws open repaired the copy of %s: %s (state in %s)", ws["key"],
+                           json.dumps(recovered)[:500], parsed.get("recoveryRef", "-"))
+        return {"path": path, "fallback": False, "exit_code": 0, "error": "",
+                "recovered": recovered if isinstance(recovered, list) else []}
+    error_text = ""
+    if isinstance(parsed, dict) and parsed.get("ok") is False:
+        error_text = str(parsed.get("error") or "")
+    if not error_text:
+        error_text = (proc.stderr or "").strip() or f"myr-ws open exited {proc.returncode}"
+    return _fallback(proc.returncode, error_text[:300])
