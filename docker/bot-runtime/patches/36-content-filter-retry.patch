+# myrmidon(G1): how many times one turn re-issues the same model call after an HTTP-200
+# ``content_filter`` refusal that the fallback chain could not take over (no fallback configured, or
+# all of them already used) before the refusal ends the turn. The refusal need not repeat for an
+# unchanged long context (the filter cut a harmless reply mid-word), and the work done so far lives
+# in the session, so a re-issue costs one model call, not the run. Not more than 2, and fewer when
+# fallbacks are configured: a re-issue goes through the turn's restart machinery, whose per-turn
+# limit (``api_max_retries``, 3) is shared with the restarts onto the fallback chain.
+_CONTENT_FILTER_RETRIES = 2
+
 _THINKING_EXHAUSTED = (
     "💭 Reasoning exhausted the output token budget — no visible response was produced.",
