         active_system_prompt = _arm_fallback_restart(agent, api_messages, active_system_prompt, _retry)
         return RefusalVerdict("break", None, active_system_prompt)
 
+    # myrmidon(G1): no fallback took over, so the refusal would end the turn here. Re-issue the same
+    # call first. The count is kept per turn (a new ``turn_id`` starts from zero) and leaves room in
+    # the turn's restart limit (``max_retries``) for the restarts onto every configured fallback
+    # (``_fallback_chain``, the list ``_has_pending_fallback`` reads), so the re-issues cannot reach it.
+    _cf_state = getattr(agent, "_content_filter_retries", None)
+    if not isinstance(_cf_state, dict) or _cf_state.get("turn") != turn_id:
+        _cf_state = {"turn": turn_id, "used": 0}
+        agent._content_filter_retries = _cf_state
+    _cf_chain = len(getattr(agent, "_fallback_chain", None) or [])
+    _cf_limit = max(0, min(_CONTENT_FILTER_RETRIES, int(max_retries) - 1 - _cf_chain))
+    if _cf_state["used"] < _cf_limit:
+        _cf_state["used"] += 1
+        logger.warning(
