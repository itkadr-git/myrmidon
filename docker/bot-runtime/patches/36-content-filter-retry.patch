+            (_refusal_text[:200] + "...") if len(_refusal_text) > 200 else (_refusal_text or "(no text)"),
+        )
+        agent._emit_diagnostic_status(
+            f"⚠️ Model declined to respond (safety refusal) — retrying "
+            f"({_cf_state['used']}/{_cf_limit})..."
+        )
+        _retry.restart_with_rebuilt_messages = True
+        return RefusalVerdict("break", None, active_system_prompt)
+
