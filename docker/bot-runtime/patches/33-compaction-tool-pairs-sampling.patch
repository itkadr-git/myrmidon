+                    tail_line = tc_lines[-1] if len(tc_lines) > 1 else "]"
+                    avail_calls = max(0, call_budget - len(hdr) - len(tail_line))
+                    inner = "".join(tc_lines[1:-1])[:avail_calls].rstrip("\n")
