+@pytest.mark.asyncio
+async def test_e_failed_async_open_is_retryable_and_recovers_once(tmp_path):
+    cache = RecoverableHandleCache(initial_retry_delay=0, max_retry_delay=0)
+    attempts = 0
+    recovered = []
+
+    async def opener():
+        nonlocal attempts
+        attempts += 1
+        if attempts == 1:
+            raise RuntimeError("boom")
+        return "ok"
+
+    path = tmp_path / "state.db"
+    assert await cache.get_async(path, opener) is None
+    assert await cache.get_async(path, opener, on_recovered=lambda: recovered.append(1)) == "ok"
+    assert recovered == [1]
