+@pytest.mark.asyncio
+async def test_f_drain_waits_for_all_settlements(tmp_path):
+    cache = RecoverableHandleCache(initial_retry_delay=0, max_retry_delay=0)
+    release = asyncio.Event()
+    started = asyncio.Event()
+
+    async def opener():
+        started.set()
+        await release.wait()
+        return "held"
+
+    task = asyncio.create_task(cache.get_async(tmp_path / "state.db", opener))
+    await started.wait()
+    drain = asyncio.create_task(cache.drain_async())
+    await asyncio.sleep(0)
+    assert not drain.done()
+    release.set()
+    assert await task == "held"
+    await drain
