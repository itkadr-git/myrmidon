+++ b/tools/stale_result_tool.py
@@ -0,0 +1,84 @@
+"""myrmidon(G1): ``read_stale_tool_result`` - the way back to a tool result that the
+request copy replaced with a note (see agent/context_economy.py).
+
+The note names a reference; this tool returns the original text behind it. The text comes from the
+store that the request build refills on every model call from the live transcript, so a reference that
+is in the request is always readable, also after a gateway restart and a session resume."""
+
+from __future__ import annotations
+
+from typing import Any, Dict
+
+from agent.context_economy import READ_TOOL_NAME, lookup_stale_result, stale_tool_results_enabled
+from tools.registry import no_cache_check_fn
+
+# One call returns at most this many characters; a longer result is read in windows (offset/limit).
+_MAX_WINDOW_CHARS = 60_000
+
+READ_STALE_TOOL_RESULT_SCHEMA: Dict[str, Any] = {
+    "name": READ_TOOL_NAME,
+    "description": (
+        "Return the full text of an earlier tool result that was left out of the conversation to save "
+        "context. Use the ref shown in the note that replaced it. Long results are returned in windows: "
+        "pass offset to continue where the previous window ended."
+    ),
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "ref": {"type": "string", "description": "The ref from the 'Stale tool result left out' note."},
+            "offset": {"type": "integer", "description": "First character to return (default 0).", "default": 0},
+            "limit": {
+                "type": "integer",
+                "description": f"Characters to return, at most {_MAX_WINDOW_CHARS} (default {_MAX_WINDOW_CHARS}).",
+            },
+        },
+        "required": ["ref"],
+    },
+}
+
+
+@no_cache_check_fn
+def check_stale_result_requirements() -> bool:
+    """Offered only while the replacement itself is on, so switching it off restores the old tool schema."""
+    return stale_tool_results_enabled()
+
+
+def read_stale_tool_result(ref: Any, offset: Any = 0, limit: Any = None, session_id: Any = None) -> str:
+    from tools.registry import tool_error
+
+    ref = str(ref or "").strip()
+    if not ref:
+        return tool_error("ref is required")
+    text = lookup_stale_result(session_id, ref)
+    if text is None:
+        return tool_error(
+            f"No stale result with ref {ref} is held for this session (it may be from before a compaction "
+            "or a restart); repeat the original call instead.")
+    try:
+        start = max(0, int(offset or 0))
+    except (TypeError, ValueError):
+        start = 0
+    try:
+        size = _MAX_WINDOW_CHARS if limit in (None, "") else max(1, min(int(limit), _MAX_WINDOW_CHARS))
+    except (TypeError, ValueError):
+        size = _MAX_WINDOW_CHARS
+    if start == 0 and len(text) <= size:
+        return text  # whole result, byte for byte
+    window = text[start:start + size]
+    end = start + len(window)
+    if end >= len(text):
+        return window + f"\n[end of result: {len(text)} chars in total]"
+    return window + f"\n[window {start}-{end} of {len(text)} chars; call {READ_TOOL_NAME} again with offset={end}]"
+
+
+from tools.registry import registry  # noqa: E402  (registration at import time)
+
+registry.register(
+    name=READ_TOOL_NAME,
+    toolset="file",
+    schema=READ_STALE_TOOL_RESULT_SCHEMA,
+    handler=lambda args, **kw: read_stale_tool_result(
+        args.get("ref"), args.get("offset", 0), args.get("limit"), session_id=kw.get("session_id")),
+    check_fn=check_stale_result_requirements,
+    emoji="📎",
+)
