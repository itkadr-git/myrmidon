+    def _vacuum_space_error(self) -> Optional[str]:
+        """Reason a VACUUM must not start for lack of room, or None. Needs 2x the live data
+        (``(page_count - freelist_count) * page_size``) free on the database's volume (temp copy + journal) when
+        SQLite's temp directory is on the same volume, else 1x on each. A temp directory in RAM (tmpfs) is
+        refused: the copy would be charged to the process's memory. Fails closed."""
+        from hermes_state_wal import _mountinfo_fstype
+        values = self._page_pragmas(("page_count", "freelist_count", "page_size"), "Could not read page counts: %s")
+        if values is None:
+            return "could not read the page counts"
+        live = (values[0] - values[1]) * values[2]
+        db_dir = os.path.dirname(os.path.realpath(self.db_path)) or "."
+        tmp_dir = _sqlite_temp_dir()
+        if tmp_dir is None:
+            return "no writable directory for SQLite's temporary file"
