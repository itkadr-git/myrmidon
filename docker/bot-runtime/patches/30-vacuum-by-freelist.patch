+def _sqlite_temp_dir() -> Optional[str]:
+    """Directory SQLite puts a VACUUM temp file in: the first of ``SQLITE_TMPDIR``, ``TMPDIR``, ``/var/tmp``,
+    ``/usr/tmp``, ``/tmp``, ``.`` that is a directory it can write (the order of os_unix.c
+    ``unixTempFileDir``; Python's sqlite3 sets no ``sqlite3_temp_directory``). None when there is none."""
+    for candidate in (os.environ.get("SQLITE_TMPDIR"), os.environ.get("TMPDIR"),
+                      "/var/tmp", "/usr/tmp", "/tmp", "."):
+        if candidate and os.path.isdir(candidate) and os.access(candidate, os.R_OK | os.W_OK | os.X_OK):
+            return os.path.realpath(candidate)
+    return None
+
+
+def _warn_once(key: str, message: str, *args) -> None:
