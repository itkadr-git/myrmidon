 FTS_TOOL_CONTENT_PREFIX_CHARS = 8_192
+# myrmidon(G1): Large wake envelopes remain in the transcript, not the FTS indexes.
+FTS_USER_CONTENT_MAX_CHARS = 2_048


 def _fts_indexed_content_sql(alias: str) -> str:
     return f"""CASE WHEN {alias}.role = 'tool'
          THEN substr(COALESCE({alias}.content, ''), 1, {FTS_TOOL_CONTENT_PREFIX_CHARS})
+         WHEN {alias}.role = 'user' AND length(COALESCE({alias}.content, '')) > {FTS_USER_CONTENT_MAX_CHARS}
+         THEN substr(COALESCE({alias}.content, ''), 1, {FTS_USER_CONTENT_MAX_CHARS})
          ELSE {alias}.content END"""


