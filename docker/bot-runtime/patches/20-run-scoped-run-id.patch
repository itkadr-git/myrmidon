@@ -0,0 +1,77 @@
+"""Run-scoped Paperclip run-id context (myrmidon G1).
+
+The board's ``hermes_gateway`` adapter POSTs each run with the attempt's own
+run id (the ``Idempotency-Key``/body identity the board's checkout guard
+expects on mutating Paperclip API calls). Inside a bot container the gateway
+process is long-lived and serves many runs, so the container-level
+``PAPERCLIP_RUN_ID``/``MYRMIDON_RUN_ID`` in ``os.environ`` belongs to
+whichever run happened to start the container — an agent reading
+``$PAPERCLIP_RUN_ID`` and sending it as ``X-Paperclip-Run-Id`` on a PATCH
+gets a stale value and the board answers ``409 Issue run ownership conflict``.
+
+``gateway/platforms/api_server_runs.py`` binds the CURRENT run's id here for
+the whole turn — contextvars, never the process env, because concurrent runs
+share ``os.environ``. ``tools/environments/local.py`` then bridges the bound
+value into the environment of every terminal/execute_code child spawned
+inside the turn, OVERRIDING the inherited (stale) container-level value, so
+``$PAPERCLIP_RUN_ID`` inside any tool call is exactly this run's id.
+"""
+
+from __future__ import annotations
+
+import re
+from contextvars import ContextVar, Token
+from typing import Any, Callable, Optional
+
+# The run id the board minted for THIS run, or None outside a run context.
+_RUN_ID: ContextVar[Optional[str]] = ContextVar("PAPERCLIP_RUN_ID_CONTEXT", default=None)
+
+# Same shape the other context modules use: a single path segment, no "..".
+_RUN_ID_PATTERN = re.compile(r"^[A-Za-z0-9_.-]{1,128}$")
+
+
+def set_run_id_vars(run_id: Any) -> tuple[Callable[[], None], Callable[[Any], None]]:
+    """Bind *run_id* for this context.
+
+    Returns ``(marker, reset)`` shaped exactly like the other (token, reset)
+    pairs the API server collects: the ``finally`` block calls
+    ``reset(token)`` for every entry, so ``reset`` must accept and ignore one
+    positional argument (the token is already closed over here).
+    """
+    value = str(run_id or "").strip()
+    token: Optional[Token[Optional[str]]] = None
+    if value and _RUN_ID_PATTERN.match(value) and ".." not in value:
+        token = _RUN_ID.set(value)
+
+    def reset(_token: Any = None) -> None:
+        # Reset to the pre-bind value, not to None — a nested binding (delegate
+        # workers re-running this module's setter under a copied context) must
+        # not clear an outer scope's id. The argument is ignored: the real
+        # token is closed over (the caller's `reset(token)` convention passes
+        # its own marker back).
+        if token is not None:
+            _RUN_ID.reset(token)
+
+    return (lambda _marker=None: None), reset
+
+
+def run_id_env() -> dict[str, str]:
+    """The run id as a child-process env fragment, or ``{}`` when unbound.
+
+    Called from the terminal child-env bridge (``local.py``) at spawn time,
+    so each subprocess sees only its own run's id. Both the Paperclip name
+    and the legacy Myrmidon alias are written: agent prompts and skills use
+    ``PAPERCLIP_RUN_ID``; some older material still reads ``MYRMIDON_RUN_ID``.
+    """
+    bound = _RUN_ID.get()
+    if not bound:
+        return {}
+    return {
+        "PAPERCLIP_RUN_ID": bound,
+        "MYRMIDON_RUN_ID": bound,
+    }
+
+
+def run_id_bound() -> bool:
+    """True when the current context carries a run id."""
+    return bool(_RUN_ID.get())
