diff --git a/tools/run_id_context.py b/tools/run_id_context.py
new file mode 100644
index 0000000000..4f6da01f13
--- /dev/null
+++ b/tools/run_id_context.py
@@ -0,0 +1,112 @@
+"""Run-scoped Paperclip run-id context (myrmidon G1).
+
+The board's ``hermes_gateway`` adapter POSTs each run with the board's own
+run id in the ``X-Paperclip-Run-Id`` request header — a UUID the board minted
+in ``heartbeat_runs``. Inside a bot container the gateway process is
+long-lived and serves many runs, so the container-level
+``PAPERCLIP_RUN_ID``/``MYRMIDON_RUN_ID`` in ``os.environ`` belongs to
+whichever run happened to start the container — an agent reading
+``$PAPERCLIP_RUN_ID`` and sending it as ``X-Paperclip-Run-Id`` on a board
+mutation either gets a stale value (409 run-ownership conflict) or, worse, a
+non-UUID value the board's ``heartbeat_runs.id`` lookup 500s on.
+
+``gateway/platforms/api_server_runs.py`` binds the request header's value
+here for the whole turn — contextvars, never the process env, because
+concurrent runs share ``os.environ``. ``tools/environments/local.py`` then
+bridges the bound value into the environment of every terminal/execute_code
+child spawned inside the turn, OVERRIDING the inherited (stale)
+container-level value, so ``$PAPERCLIP_RUN_ID`` inside any tool call is
+exactly this run's board run id.
+
+myrmidon(G1): only a UUID is a board run id. The gateway's internal
+``run.run_id`` (``run_<hex>``) must never be bound — binding it was the
+rc.29 defect that made every agent board mutation fail with HTTP 500
+(``invalid input syntax for type uuid: "run_..."``). The board now also
+guards its side, but the bot must not emit the garbage in the first place.
+"""
+
+from __future__ import annotations
+
+import re
+from contextvars import ContextVar, Token
+from typing import Any, Callable, Optional
+
+# The board run id the board minted for THIS run, or None outside a run context.
+_RUN_ID: ContextVar[Optional[str]] = ContextVar("MYRMIDON_RUN_ID_CONTEXT", default=None)
+
+# myrmidon(G1): a board run id is a UUID and nothing else. The
+# rc.29 regression shipped the gateway's internal ``run_<hex>`` id through
+# this context; the strict pattern is the belt, the 400 on a malformed
+# ``X-Paperclip-Run-Id`` header in _handle_runs is the braces.
+_UUID_PATTERN = re.compile(
+    r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
+    r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
+)
+
+
+def normalize_board_run_id(value: Any) -> Optional[str]:
+    """Return *value* as a board run id, or None when it is not a UUID.
+
+    Strips surrounding whitespace; accepts exactly the UUID shape the board
+    stores in ``heartbeat_runs.id``. Anything else — empty, ``run_<hex>``,
+    an idempotency key, an attempt label — is None, so a caller can treat a
+    malformed ``X-Paperclip-Run-Id`` header as the bug it is instead of
+    forwarding it into $PAPERCLIP_RUN_ID.
+    """
+    text = str(value or "").strip()
+    if not text:
+        return None
+    if not _UUID_PATTERN.match(text):
+        return None
+    return text
+
+
+def set_run_id_vars(run_id: Any) -> tuple[Callable[[], None], Callable[[Any], None]]:
+    """Bind *run_id* for this context.
+
+    Returns ``(marker, reset)`` shaped exactly like the other (token, reset)
+    pairs the API server collects: the ``finally`` block calls
+    ``reset(token)`` for every entry, so ``reset`` must accept and ignore one
+    positional argument (the token is already closed over here).
+
+    myrmidon(G1): a non-UUID *run_id* binds NOTHING. The setter is
+    the last line of defence — whatever the caller passes, only a UUID
+    reaches the contextvar.
+    """
+    value = normalize_board_run_id(run_id)
+    token: Optional[Token[Optional[str]]] = None
+    if value is not None:
+        token = _RUN_ID.set(value)
+
+    def reset(_token: Any = None) -> None:
+        # Reset to the pre-bind value, not to None — a nested binding (delegate
+        # workers re-running this module's setter under a copied context) must
+        # not clear an outer scope's id. The argument is ignored: the real
+        # token is closed over (the caller's `reset(token)` convention passes
+        # its own marker back).
+        if token is not None:
+            _RUN_ID.reset(token)
+
+    return (lambda _marker=None: None), reset
+
+
+def run_id_env() -> dict[str, str]:
+    """The board run id as a child-process env fragment, or ``{}`` when unbound.
+
+    Called from the terminal child-env bridge (``local.py``) at spawn time,
+    so each subprocess sees only its own run's id. Both the Paperclip name
+    and the legacy Myrmidon alias are written: agent prompts and skills use
+    ``PAPERCLIP_RUN_ID``; some older material still reads ``MYRMIDON_RUN_ID``.
+    """
+    bound = _RUN_ID.get()
+    if not bound:
+        return {}
+    return {
+        "PAPERCLIP_RUN_ID": bound,
+        "MYRMIDON_RUN_ID": bound,
+    }
+
+
+def run_id_bound() -> bool:
+    """True when the current context carries a board run id."""
+    return bool(_RUN_ID.get())
