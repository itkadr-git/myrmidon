+    # myrmidon(G1): a write whose commit fails (disk full, I/O error, busy timeout) must not
+    # leave the connection inside its transaction; see _write_locked and _recover_open_txn_locked.
+    def _safe_rollback_locked(self) -> None:
+        """Roll back the open transaction (caller holds the lock); a failing rollback is logged."""
+        try:
+            self._conn.rollback()
+        except sqlite3.Error:
+            logger.warning("Run idempotency store: rollback failed", exc_info=True)
+
+    def _recover_open_txn_locked(self, where: str) -> None:
+        """Roll back a transaction a failed write left open (caller holds the lock).
+
+        A ``commit()`` that raises (disk full, I/O error, busy timeout) leaves the
+        connection inside its transaction. Without this, every later
+        ``BEGIN IMMEDIATE`` fails with "cannot start a transaction within a
+        transaction" and each run request answers 500 until the process restarts.
+        """
+        if self._conn.in_transaction:
+            logger.warning("Run idempotency store: rolling back a transaction left open before %s", where)
+            self._safe_rollback_locked()
+
+    def _write_locked(self, sql: str, params: tuple) -> int:
+        """Run one write and commit it (caller holds the lock); any error rolls back."""
+        self._recover_open_txn_locked("a write")
+        try:
+            rowcount = self._conn.execute(sql, params).rowcount
+            self._conn.commit()
+        except Exception:
+            self._safe_rollback_locked()
+            raise
+        return rowcount
+
