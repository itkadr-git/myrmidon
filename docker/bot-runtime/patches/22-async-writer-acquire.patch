diff --git a/tests/gateway/test_session_db_handle_shutdown.py b/tests/gateway/test_session_db_handle_shutdown.py
new file mode 100644
index 0000000000..9872483796
--- /dev/null
+++ b/tests/gateway/test_session_db_handle_shutdown.py
@@ -0,0 +1,45 @@
+import asyncio
+from pathlib import Path
+
+from gateway.session_persistence import SessionPersistenceMixin
+
+
+class _Handle:
+    closed = False
+
+    def close(self):
+        self.closed = True
+
+
+class _Cache:
+    def __init__(self, handles):
+        self.handles = handles
+
+    async def get_async(self, path, opener, **_kwargs):
+        handle = await opener()
+        self.handles[path] = handle
+        self.handles.clear()
+        handle.close()
+        return handle
+
+
+def test_async_open_does_not_reinsert_after_shutdown():
+    async def run():
+        handles = {}
+        store = SessionPersistenceMixin.__new__(SessionPersistenceMixin)
+        store._db_handles = handles
+        store._db_handle_cache = _Cache(handles)
+        import hermes_state_registry
+        original = hermes_state_registry.acquire_async
+        hermes_state_registry.acquire_async = lambda *_a, **_k: _resolved(_Handle())
+        try:
+            result = await store._open_session_db_for_path_async(Path("state.db"))
+        finally:
+            hermes_state_registry.acquire_async = original
+        assert result.closed
+        assert handles == {}
+    asyncio.run(run())
+
+
+async def _resolved(value):
+    return value
