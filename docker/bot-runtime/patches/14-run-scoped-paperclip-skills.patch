+++ b/tools/run_skills.py
@@ -0,0 +1,169 @@
+"""myrmidon(G1): run-scoped Myrmidon-managed skill materialization (1.6.6-HERMES-SKILLS-A).
+
+The board's hermes_gateway adapter cannot reach the gateway's filesystem: it
+talks to the API only, and the pinned API surface has no endpoint that writes
+a profile's skills or its skills.external_dirs. The adapter therefore carries
+the run's desired skills in the /v1/runs body field ``paperclip_skills`` —
+``[{"path": <rel>, "name": <frontmatter name>, "content": <SKILL.md text>}]``
+— and ``_run_agent_sync`` materializes them here, inside the run's profile
+scope, before the model starts: each entry lands at
+``<profile skills root>/paperclip-managed/<path>/SKILL.md``.
+
+Isolation discipline (mirrors the board-side hermes_local reconcile):
+
+* Writes go only to this run's profile (``tools/skills_tool._skills_dir``
+  honours the profile scope bound by ``_profile_scope``) and only under the
+  ``paperclip-managed`` segment, so two agents running side by side on one
+  gateway never share a target.
+* Removal touches only the managed segment of THIS profile — stale entries a
+  previous run of this agent delivered are removed; directories outside the
+  segment are never looked at, let alone modified.
+* Path safety: an entry whose ``path`` would escape the managed root (``..``,
+  absolute, empty, unsafe characters) is skipped, never written; the verify
+  step then fails the run on it instead of starting without the skill.
+
+``materialize_run_skills`` returns ``{name: relpath}`` for the entries
+actually written; ``verify_run_skills`` compares that with the desired set
+and names the first missing skill, so a half-written delivery fails loudly
+before the model sees a turn.
+"""
+
+from __future__ import annotations
+
+import shutil
+from contextvars import ContextVar, Token
+from pathlib import Path
+from typing import Any, Dict, List, Optional
+
+_MANAGED_SEGMENT = "paperclip-managed"
+_SKILL_FILE = "SKILL.md"
+_MAX_SKILLS = 200
+_MAX_CONTENT_BYTES = 512 * 1024
+_NAME_SAFE = set("abcdefghijklmnopqrstuvwxyz0123456789._-")
+
+# The managed skills root of the current run's profile, or None when the
+# request carried no ``paperclip_skills`` field. Bound in the run's executor
+# thread (``_run_agent_sync``), never in the process env — a gateway process
+# serves many concurrent runs that share ``os.environ``; the local env bridge
+# copies the value into THIS run's child processes only.
+_RUN_SKILLS_DIR: ContextVar = ContextVar("MYRMIDON_RUN_SKILLS_DIR", default=None)
+_RUN_SKILLS_ENV = "MYRMIDON_RUN_SKILLS_DIR"
+
+
+def set_run_skills_dir(path: str) -> Token:
+    """Bind the managed skills root for the current run context."""
+    return _RUN_SKILLS_DIR.set(path)
+
+
+def reset_run_skills_dir(token: Token) -> None:
+    _RUN_SKILLS_DIR.reset(token)
+
+
+def run_skills_env() -> Dict[str, str]:
+    """The child-process env fragment for the bound skills dir, or ``{}``."""
+    bound = _RUN_SKILLS_DIR.get()
+    return {} if bound is None else {_RUN_SKILLS_ENV: bound}
+
+
+def run_skills_env_name() -> str:
+    return _RUN_SKILLS_ENV
+
+
+def _managed_root() -> Path:
+    # ``_skills_dir`` resolves the active profile's skills root at call time
+    # (profile-scoped HERMES_HOME), so the write lands in the profile the run
+    # is bound to, never in another agent's profile.
+    from tools.skills_tool import _skills_dir
+
+    return _skills_dir() / _MANAGED_SEGMENT
+
+
+def _safe_relpath(raw: Any) -> Optional[str]:
+    """A delivery path, or None when it would escape the managed root."""
+    if not isinstance(raw, str):
+        return None
+    rel = raw.strip().strip("/").replace("\\", "/")
+    if not rel:
+        return None
+    parts = [p for p in rel.split("/") if p]
+    if any(p in (".", "..") or not set(p.lower()) <= _NAME_SAFE for p in parts):
+        return None
+    return "/".join(parts)
+
+
+def materialize_run_skills(entries: List[Dict[str, Any]]) -> Dict[str, str]:
+    """Write the run's skills into this profile's managed segment.
+
+    Returns ``{name: relpath}`` for the entries actually written; skipped
+    entries (invalid path/name/content) are absent from the map so the
+    caller's verification fails the run on them instead of starting without
+    a skill.
+    """
+    root = _managed_root()
+    written: Dict[str, str] = {}
+    root.mkdir(parents=True, exist_ok=True)
+    for entry in entries[:_MAX_SKILLS]:
+        if not isinstance(entry, dict):
+            continue
+        rel = _safe_relpath(entry.get("path"))
+        name = entry.get("name")
+        content = entry.get("content")
+        if rel is None or not isinstance(name, str) or not name.strip():
+            continue
+        if not isinstance(content, str) or not content.strip():
+            continue
+        if len(content.encode("utf-8", "ignore")) > _MAX_CONTENT_BYTES:
+            continue
+        target_dir = root / rel
+        target_dir.mkdir(parents=True, exist_ok=True)
+        (target_dir / _SKILL_FILE).write_text(content, encoding="utf-8")
+        written[name.strip()] = rel
+    # Removal scope: only this profile's managed segment, and only entries no
+    # longer desired. Anything else on disk is left untouched (the H1
+    # discipline: never delete what the user or another surface put there).
+    keep = {rel.split("/")[0] for rel in written.values()}
+    for child in root.iterdir():
+        if child.is_dir() and child.name not in keep:
+            shutil.rmtree(child, ignore_errors=True)
+    return written
+
+
+def verify_run_skills(entries: List[Dict[str, Any]], written: Dict[str, str]) -> Optional[str]:
+    """The receiver-side fact-check: every desired entry must be on disk.
+
+    Returns None on success, else the name of the first missing skill. An
+    entry skipped by the path/content guards still counts as desired here —
+    the run must fail on it, not silently start without the skill.
+    """
+    for entry in entries[:_MAX_SKILLS]:
+        if not isinstance(entry, dict):
+            continue
+        name = entry.get("name")
+        if isinstance(name, str) and name.strip() and name.strip() not in written:
+            return name.strip()
+    return None
+
+def skip_reason(entries: List[Dict[str, Any]], name: str) -> str:
+    """Why the entry called ``name`` was not written (for the run-failure message).
+
+    The board adapter once sent ``content`` as a serialized Node Buffer
+    (``{"type": "Buffer", ...}``); the guards silently skipped every entry and
+    the only symptom was "not materialized". Name the guard that fired.
+    """
+    for entry in entries[:_MAX_SKILLS]:
+        if not isinstance(entry, dict):
+            continue
+        entry_name = entry.get("name")
+        if not (isinstance(entry_name, str) and entry_name.strip() == name):
+            continue
+        if _safe_relpath(entry.get("path")) is None:
+            return f"unsafe or empty path {entry.get('path')!r}"
+        content = entry.get("content")
+        if not isinstance(content, str):
+            return f"content is {type(content).__name__}, expected str"
+        if not content.strip():
+            return "content is empty"
+        if len(content.encode("utf-8", "ignore")) > _MAX_CONTENT_BYTES:
+            return f"content exceeds {_MAX_CONTENT_BYTES} bytes"
+        return "unknown"
+    return "no such entry in the field (names are matched exactly)"
