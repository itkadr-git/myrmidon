#!/usr/bin/env node
// docker/bot-runtime/github-broker/gh
//
// myrmidon(G1): gh wrapper for run-scoped GitHub credentials
// (CONTAINER-GITHUB-WRITE). Stands earlier in PATH than the real gh. When the
// environment of THIS run carries PAPERCLIP_GITHUB_BROKER_TOKEN (the hermes
// gateway patch exports it, with PAPERCLIP_GITHUB_BROKER_URL as the primary
// broker URL, into the run's terminal children), the wrapper asks the board's
// broker (POST /runtime-tools/github/credentials) for the credential and runs
// the real gh with the returned env applied — and only the allow-listed keys,
// the same list the board's own launcher applies
// (packages/adapter-utils/src/myrmidon-github-broker.ts).
//
// Broker candidates follow the same walk as the board's launcher client:
// PAPERCLIP_GITHUB_BROKER_URL → PAPERCLIP_API_URL →
// PAPERCLIP_RUNTIME_API_URL → items of
// PAPERCLIP_RUNTIME_API_CANDIDATES_JSON (max 6, deduped, trailing / and /api
// stripped); a 409 is retried on the same candidate, a dead or unreachable
// candidate never stops the walk. Diagnostics name candidate URLs and
// statuses, never the token.
//
// Without a capability (or when the broker refuses) the real gh runs with the
// environment unchanged: the wrapper never breaks gh for a run that has no
// managed GitHub identity. The capability never appears in argv, in gh's
// config, or on disk; only this invocation and its children see the resolved
// token: it is passed as env to the child process, not exported to the shell.

const fs = require("node:fs");
const path = require("node:path");
const { spawn, spawnSync } = require("node:child_process");

const HTTP_TIMEOUT_MS = 10_000;
const TOTAL_TIMEOUT_MS = 60_000;
const CONFLICT_RETRY_DELAY_MS = 1_000;
const CONFLICT_MAX_ATTEMPTS = 30;
const MAX_CANDIDATES = 6;

const directory = path.dirname(fs.realpathSync(process.argv[1]));
const originalPath = (process.env.PATH || "").split(path.delimiter).filter((p) => {
  try { return fs.realpathSync(p) !== directory; } catch { return true; }
});
const gitWrapperPaths = new Set([
  directory,
  "/opt/paperclip/bin",
  "/usr/local/bin",
].map((p) => { try { return fs.realpathSync(path.join(p, "git")); } catch { return ""; } }).filter(Boolean));
async function realGitExecutable() {
  const configured = process.env.MYRMIDON_GIT_REAL;
  if (configured) {
    try {
      const resolved = fs.realpathSync(path.resolve(configured));
      if (!gitWrapperPaths.has(resolved)) return configured;
    } catch {}
  }
  for (const dir of originalPath) {
    const candidate = path.join(dir, "git");
    try {
      if (!fs.statSync(candidate).isFile() || fs.accessSync(candidate, fs.constants.X_OK) !== undefined) continue;
      if (gitWrapperPaths.has(fs.realpathSync(candidate))) continue;
      // The incident (OPE-12510): a PATH git that re-executes this wrapper on
      // the origin-remote lookup loops the two shims until the PID limit kills
      // the bot. A candidate must answer the incident command on its own
      // before it is trusted for the real command; a probe that never exits
      // proves a loop and the group is killed.
      if (process.env.PAPERCLIP_GIT_PROBE_ACTIVE === "1") return candidate;
      const probeEnv = { ...process.env, PAPERCLIP_GIT_PROBE_ACTIVE: "1", PAPERCLIP_GITHUB_OPERATION_ACTIVE: "1" };
      const probe = spawn(candidate, ["config", "--get", "remote.origin.url"], {
        cwd: process.cwd(), env: probeEnv, stdio: ["ignore", "ignore", "ignore"],
        // No spawn timeout here: it would signal only the direct child and
        // orphan a looping candidate's descendants. The group kill below is
        // the single owner of the probe deadline.
        detached: true,
      });
      const pid = probe.pid;
      let settled = false;
      const verdict = new Promise((resolve) => {
        probe.once("exit", (code) => { settled = true; resolve(code === 0 || code === 1); });
        probe.once("error", () => { settled = true; resolve(false); });
      });
      const timer = setTimeout(() => {
        if (settled || !pid) return;
        try { process.kill(-pid, "SIGKILL"); } catch { try { probe.kill("SIGKILL"); } catch {} }
      }, 3000);
      const safe = await verdict;
      clearTimeout(timer);
      if (!safe) continue;
      return candidate;
    } catch { continue; }
  }
  for (const candidate of ["/opt/paperclip/libexec/git", "/usr/bin/git"]) {
    try {
      if (fs.statSync(candidate).isFile() && fs.accessSync(candidate, fs.constants.X_OK) === undefined) return candidate;
    } catch {}
  }
  return "/opt/paperclip/libexec/git";
}
const executable = originalPath.map((p) => path.join(p, "gh")).find((p) => {
  try { fs.accessSync(p, fs.constants.X_OK); return fs.statSync(p).isFile(); } catch { return false; }
});
if (!executable) {
  process.stderr.write("paperclip: gh is not installed.\n");
  process.exit(127);
}

// Same candidate walk as the board's launcher client: env-key precedence,
// trailing-slash and /api-suffix stripping, dedup, cap at 6 candidates.
function brokerCandidateUrls(env) {
  const urls = [];
  const seen = new Set();
  const push = (value) => {
    const trimmed = typeof value === "string" ? value.trim().replace(/\/+$/, "").replace(/\/api$/, "") : "";
    if (!trimmed || seen.has(trimmed) || urls.length >= MAX_CANDIDATES) return;
    seen.add(trimmed);
    urls.push(trimmed);
  };
  push(env.PAPERCLIP_GITHUB_BROKER_URL);
  push(env.MYRMIDON_API_URL);
  push(env.PAPERCLIP_API_URL);
  push(env.PAPERCLIP_RUNTIME_API_URL);
  let extra = [];
  try {
    const parsed = JSON.parse(env.PAPERCLIP_RUNTIME_API_CANDIDATES_JSON || "[]");
    if (Array.isArray(parsed)) extra = parsed;
  } catch { /* malformed JSON falls back to the empty list */ }
  for (const item of extra) push(item);
  return urls;
}

// myrmidon(GITHUB-SHARED-IDENTITY): the repository this gh invocation targets,
// as `owner/repo`, forwarded to the broker (a GitHub App token is minted
// per repository, for allowed ones only; an OAuth identity ignores it).
// Sources, first match wins: -R/--repo, GH_REPO, the `repos/OWNER/REPO` path
// of `gh api`, then the origin remote of the current directory. Only github.com
// references are accepted. When none is known the broker may still infer the
// repository of the run's project; failing that it answers `absent` with the
// reason code `repository_required` and this wrapper says so in plain words
// (and `gh auth status` reports the broker's state instead of "not logged in").
function normalizeRepository(value) {
  if (typeof value !== "string") return null;
  let rest = value.trim();
  if (!rest) return null;
  const scp = /^git@(?:www\.)?github\.com:(.+)$/i.exec(rest);
  if (scp) {
    rest = scp[1];
  } else if (/^[a-z][a-z0-9+.-]*:\/\//i.test(rest)) {
    let parsed;
    try { parsed = new URL(rest); } catch { return null; }
    const host = parsed.hostname.toLowerCase();
    if (host !== "github.com" && host !== "www.github.com") return null;
    rest = parsed.pathname;
  } else {
    const parts = rest.split("/").filter((part) => part.length > 0);
    // [HOST/]OWNER/REPO, as gh itself accepts it.
    if (parts.length === 3) {
      const host = parts[0].toLowerCase();
      if (host !== "github.com" && host !== "www.github.com") return null;
      rest = parts.slice(1).join("/");
    }
  }
  const segments = rest.split("/").filter((segment) => segment.length > 0);
  if (segments.length < 2) return null;
  const owner = segments[0];
  const repo = segments[1].replace(/\.git$/i, "");
  if (!/^[A-Za-z0-9][A-Za-z0-9-]{0,38}$/.test(owner) || !/^[A-Za-z0-9._-]{1,100}$/.test(repo)) return null;
  return `${owner}/${repo}`;
}

function repoFromArgs(args) {
  for (let index = 0; index < args.length; index++) {
    const arg = args[index];
    if (arg === "--") break;
    if (arg === "-R" || arg === "--repo") return args[index + 1] ?? null;
    if (arg.startsWith("--repo=")) return arg.slice("--repo=".length);
    if (arg.startsWith("-R") && arg.length > 2) return arg.slice(2);
  }
  return null;
}

// `gh api repos/OWNER/REPO/...` names its repository in the endpoint.
function repoFromApiEndpoint(args) {
  if (args[0] !== "api") return null;
  for (const arg of args.slice(1)) {
    if (arg === "--") break;
    if (arg.startsWith("-")) continue;
    const match = /^\/?repos\/([^/?#]+)\/([^/?#]+)/.exec(arg);
    if (match) return normalizeRepository(`${match[1]}/${match[2]}`);
  }
  return null;
}

function targetRepository(args, env) {
  const explicit = repoFromArgs(args) ?? (env.GH_REPO || null);
  if (explicit) return normalizeRepository(explicit);
  const fromEndpoint = repoFromApiEndpoint(args);
  if (fromEndpoint) return fromEndpoint;
  try {
    const result = spawnSync(awaitRealGit(), ["config", "--get", "remote.origin.url"], {
      env: { ...env, PATH: originalPath.join(path.delimiter), PAPERCLIP_GITHUB_OPERATION_ACTIVE: "1" },
      encoding: "utf8",
      timeout: 5_000,
      stdio: ["ignore", "pipe", "ignore"],
    });
    return result.status === 0 ? normalizeRepository(result.stdout) : null;
  } catch {
    return null;
  }
}

// Resolved once per invocation; the origin-remote lookup reuses this answer so
// the re-entry probe never runs twice.
const resolvedRealGit = { value: undefined };
async function resolveRealGit() {
  if (resolvedRealGit.value === undefined) resolvedRealGit.value = await realGitExecutable();
  return resolvedRealGit.value;
}
// Synchronous read of the resolution that already happened in the main flow.
function awaitRealGit() {
  return resolvedRealGit.value ?? "/opt/paperclip/libexec/git";
}

// Plain http is the norm inside the bots' docker network (the board is
// http://paperclip-server-1:3100 there); https is used unchanged.
function postOnce(base, capability, body) {
  const url = new URL("/runtime-tools/github/credentials", base);
  const lib = url.protocol === "http:" ? require("node:http") : require("node:https");
  return new Promise((resolve) => {
    const req = lib.request(url, {
      method: "POST",
      timeout: HTTP_TIMEOUT_MS,
      headers: {
        "authorization": `Bearer ${capability}`,
        "x-myrmidon-github-capability": capability,
        "x-paperclip-github-capability": capability,
        "content-type": "application/json",
        "content-length": Buffer.byteLength(body),
        "user-agent": "paperclip-gh-wrapper/1.0 (contact: itkadr@gmail.com)",
      },
    }, (response) => {
      let body = "";
      response.setEncoding("utf8");
      response.on("data", (chunk) => { body += chunk; });
      response.on("end", () => resolve({ status: response.statusCode, body }));
    });
    req.on("timeout", () => req.destroy(new Error("timeout")));
    req.on("error", () => resolve(null));
    req.end(body);
  });
}

// Walk the candidates with 409-retry-on-same-candidate semantics, bounded by
// a total deadline. Returns { response, tried }: the first 200, else the last
// HTTP response seen, else null; `tried` names each candidate URL and its
// outcome for diagnostics (never the token).
async function requestBrokerCredentials(env, candidateUrls, body) {
  const deadline = Date.now() + TOTAL_TIMEOUT_MS;
  const tried = [];
  let lastResponse = null;
  for (const base of candidateUrls) {
    let response = null;
    let outcome = "no_response";
    try {
      for (let attempt = 0; attempt < CONFLICT_MAX_ATTEMPTS; attempt++) {
        const remaining = deadline - Date.now();
        if (remaining <= 0) { outcome = "budget_exhausted"; break; }
        response = await postOnce(base, env.PAPERCLIP_GITHUB_BROKER_TOKEN, body);
        if (!response) { outcome = "no_response"; break; }
        outcome = String(response.status);
        if (response.status !== 409) break;
        await new Promise((resolve) => setTimeout(resolve, Math.max(0, Math.min(CONFLICT_RETRY_DELAY_MS, deadline - Date.now()))));
      }
    } catch {
      response = null;
      outcome = "no_response";
    }
    if (response && response.status === 200) return { response, tried };
    if (response) lastResponse = response;
    tried.push(`${base} -> ${outcome}`);
    if (Date.now() >= deadline) break;
  }
  return { response: lastResponse, tried };
}

// The same allow-list the board's launcher applies to the broker's `env`
// (the credential cache below stores the same subset).
const ALLOWED_ENV_KEYS = /^(GH_TOKEN|GITHUB_TOKEN|PAPERCLIP_GIT_TOKEN|GIT_TERMINAL_PROMPT|GIT_AUTHOR_(NAME|EMAIL)|GIT_COMMITTER_(NAME|EMAIL)|GIT_CONFIG_COUNT|GIT_CONFIG_(KEY|VALUE)_\d+)$/;

// myrmidon(OPE-12446): run-scoped on-disk credential cache (git-credential-paperclip
// carries the same block). Keyed by sha256(capability|repository) inside the
// per-run directory named by PAPERCLIP_GITHUB_CREDENTIALS_CACHE_DIR; no
// directory named → cache OFF (tests see exact request counts they assert).
// Entry { issuedAt, expiresAt, env } with mode 0600; stale/corrupt entries are
// removed, never trusted.
const CACHE_TTL_MS = 45 * 60 * 1000;
const CACHE_EXPIRY_MARGIN_MS = 60 * 1000;

function brokerCacheFile(env, repository) {
  const dir = String(env.PAPERCLIP_GITHUB_CREDENTIALS_CACHE_DIR || "").trim();
  if (!dir) return null;
  try {
    const fs = require("node:fs");
    const cacheDir = require("node:path").join(dir, ".paperclip-broker-cache");
    fs.mkdirSync(cacheDir, { recursive: true, mode: 0o700 });
    return require("node:path").join(cacheDir, require("node:crypto").createHash("sha256")
      .update(String(env.PAPERCLIP_GITHUB_BROKER_TOKEN || "") + "|" + String(repository || ""))
      .digest("hex")
      .slice(0, 32) + ".json");
  } catch { return null; }
}

function brokerCacheLoad(env, repository, now) {
  const file = brokerCacheFile(env, repository);
  if (!file) return null;
  try {
    const fs = require("node:fs");
    const entry = JSON.parse(fs.readFileSync(file, "utf8"));
    const issuedAt = Number(entry.issuedAt);
    const expiresAt = Number(entry.expiresAt);
    const token = entry.env && typeof entry.env.GH_TOKEN === "string" ? entry.env.GH_TOKEN : "";
    if (!token || !Number.isFinite(issuedAt) || !Number.isFinite(expiresAt)
        || expiresAt - CACHE_EXPIRY_MARGIN_MS <= now || now - issuedAt > CACHE_TTL_MS) {
      try { fs.rmSync(file, { force: true }); } catch {}
      return null;
    }
    return entry;
  } catch { return null; }
}

function brokerCacheStore(env, repository, result, now) {
  const file = brokerCacheFile(env, repository);
  if (!file) return;
  try {
    if (!result || result.status !== "available" || !result.env || typeof result.env.GH_TOKEN !== "string") return;
    const cachedEnv = {};
    for (const [key, value] of Object.entries(result.env)) {
      if (ALLOWED_ENV_KEYS.test(key) && typeof value === "string") cachedEnv[key] = value;
    }
    if (!cachedEnv.GH_TOKEN) return;
    let expiresAt = now + CACHE_TTL_MS;
    const declared = Date.parse(String(result.expiresAt || ""));
    if (Number.isFinite(declared)) expiresAt = Math.min(declared, expiresAt);
    require("node:fs").writeFileSync(file, JSON.stringify({ issuedAt: now, expiresAt, env: cachedEnv }), { mode: 0o600 });
  } catch { /* an unwritable cache must not break the operation */ }
}

function isAuthStatus(args) {
  return args[0] === "auth" && args[1] === "status";
}

function cleanText(value, limit) {
  return String(value).replace(/[\x00-\x1f\x7f]/g, " ").slice(0, limit);
}

function repositoryHints(result) {
  const list = Array.isArray(result.availableRepositories)
    ? result.availableRepositories.filter((item) => typeof item === "string").slice(0, 20).map((item) => cleanText(item, 140))
    : [];
  return list.length > 0 ? list.join(", ") : "";
}

const REPOSITORY_REQUIRED_MESSAGE = "GitHub access is available through the Paperclip broker, but no repository is set: pass -R owner/repo, set GH_REPO, or work inside a clone of the repository";

// `gh auth status` asked of the broker's answer, not of the real gh (which
// holds no login of its own and would report "not logged in").
function reportAuthStatus(result) {
  const lines = ["github.com"];
  if (result.status === "available") {
    const login = typeof result.login === "string" && result.login ? ` as ${cleanText(result.login, 80)}` : "";
    const source = result.source === "app" ? "GitHub App identity" : result.source === "pat" ? "scoped token" : "managed identity";
    const repository = typeof result.repository === "string" ? cleanText(result.repository, 140) : "";
    lines.push(`  ✓ Logged in through the Paperclip broker${login} (${source})`);
    if (repository) lines.push(`  - Repository: ${repository}`);
    lines.push("  - The token is issued per command; it is not stored in gh's config");
  } else if (result.reasonCode === "repository_required") {
    lines.push("  ✓ GitHub access is available through the Paperclip broker (no repository selected yet)");
    const hints = repositoryHints(result);
    if (hints) lines.push(`  - Allowed repositories: ${hints}`);
    lines.push("  - Pass -R owner/repo, set GH_REPO, or work inside a clone of the repository");
  } else {
    return false;
  }
  process.stdout.write(`${lines.join("\n")}\n`);
  return true;
}

function isPrCreate(args) {
  for (let i = 0; i < args.length - 1; i++) {
    if (args[i] === "pr" && args[i + 1] === "create") return true;
  }
  return false;
}

function sanitizePrCreateBase(args) {
  const result = [];
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (arg === "-B" || arg === "--base") {
      const val = args[i + 1];
      if (val && val.startsWith("bot/")) {
        process.stderr.write(`paperclip: base branch '${val}' is a bot branch; changing base to 'main'\n`);
        result.push(arg, "main");
        i++;
      } else {
        result.push(arg);
      }
    } else if (arg.startsWith("--base=")) {
      const val = arg.slice("--base=".length);
      if (val.startsWith("bot/")) {
        process.stderr.write(`paperclip: base branch '${val}' is a bot branch; changing base to 'main'\n`);
        result.push("--base=main");
      } else {
        result.push(arg);
      }
    } else if (arg.startsWith("-B=")) {
      const val = arg.slice("-B=".length);
      if (val.startsWith("bot/")) {
        process.stderr.write(`paperclip: base branch '${val}' is a bot branch; changing base to 'main'\n`);
        result.push("-B=main");
      } else {
        result.push(arg);
      }
    } else {
      result.push(arg);
    }
  }
  return result;
}

async function main() {
  await resolveRealGit();
  const env = { ...process.env };
  if (env.PAPERCLIP_GITHUB_OPERATION_ACTIVE === "1") {
    env.PATH = originalPath.join(path.delimiter);
    const child = spawn(executable, process.argv.slice(2), { env, stdio: "inherit" });
    for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) process.on(signal, () => child.kill(signal));
    child.once("error", () => { process.stderr.write("paperclip: gh could not start.\n"); process.exitCode = 1; });
    child.once("exit", (code) => { process.exitCode = code === null ? 128 : code; });
    return;
  }
  const capability = (env.PAPERCLIP_GITHUB_BROKER_TOKEN || "").trim();
  if (capability) {
    const repository = targetRepository(process.argv.slice(2), env);
    const body = JSON.stringify(repository ? { repository } : {});
    // myrmidon(OPE-12446): serve a still-valid cached credential without
    // contacting the broker (per-run dir from
    // PAPERCLIP_GITHUB_CREDENTIALS_CACHE_DIR; off when unset).
    const cached = brokerCacheLoad(env, repository, Date.now());
    if (cached) {
      for (const [key, value] of Object.entries(cached.env)) env[key] = value;
      env.PATH = originalPath.join(path.delimiter);
      let childArgs = process.argv.slice(2);
      if (isPrCreate(childArgs)) childArgs = sanitizePrCreateBase(childArgs);
      const child = spawn(executable, childArgs, { env, stdio: "inherit" });
      for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) process.on(signal, () => child.kill(signal));
      child.once("error", () => { process.stderr.write("paperclip: gh could not start.\n"); process.exitCode = 1; });
      child.once("exit", (code, signal) => { process.exitCode = code === null ? 128 : code; });
      return;
    }
    const { response, tried } = await requestBrokerCredentials(env, brokerCandidateUrls(env), body);
    if (!response) {
      process.stderr.write(`paperclip: GitHub broker unreachable (tried: ${tried.join(", ") || "no candidate"}); continuing without managed credentials.\n`);
    } else if (response.status !== 200) {
      process.stderr.write(`paperclip: GitHub broker answered HTTP ${response.status} (tried: ${tried.join(", ")}); continuing without managed credentials.\n`);
    } else {
      let result;
      try { result = JSON.parse(response.body); } catch { result = null; }
      if (result && result.status === "available" && result.env && result.env.GH_TOKEN) {
        // myrmidon(OPE-12446): the broker issued (or reused) a credential for
        // this run+repository — remember it for the following invocations.
        brokerCacheStore(env, repository, result, Date.now());
      }
      if (result && isAuthStatus(process.argv.slice(2)) && reportAuthStatus(result)) {
        process.exitCode = 0;
        return;
      }
      if (result && result.status === "absent" && result.reasonCode === "repository_required") {
        const hints = repositoryHints(result);
        process.stderr.write(`paperclip: ${REPOSITORY_REQUIRED_MESSAGE}${hints ? ` (allowed: ${hints})` : ""}; continuing without managed credentials.\n`);
      } else if (result && result.status === "absent") {
        const reason = typeof result.reason === "string" ? cleanText(result.reason, 300) : "no GitHub identity connected";
        process.stderr.write(`paperclip: no managed GitHub identity for this run (${reason}); continuing without managed credentials.\n`);
      }
      if (result && result.status === "unavailable") {
        const reason = typeof result.reason === "string"
          ? result.reason.replace(/[\x00-\x1f\x7f]/g, " ").slice(0, 500)
          : "check the GitHub connection in Paperclip";
        process.stderr.write(`paperclip: GitHub access unavailable: ${reason}; continuing without managed credentials.\n`);
      }
      if (result && result.status === "available" && result.env) {
        for (const [key, value] of Object.entries(result.env)) {
          if (ALLOWED_ENV_KEYS.test(key) && typeof value === "string") env[key] = value;
        }
      }
    }
  } else {
    process.stderr.write("paperclip: no GitHub broker capability in this environment; continuing without managed credentials.\n");
  }
  // Only this invocation and its children inherit the resolved token.
  env.PATH = originalPath.join(path.delimiter);
  env.PAPERCLIP_GITHUB_OPERATION_ACTIVE = "1";
  let childArgs = process.argv.slice(2);
  if (isPrCreate(childArgs)) {
    childArgs = sanitizePrCreateBase(childArgs);
  }
  const child = spawn(executable, childArgs, { env, stdio: "inherit" });
  for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) process.on(signal, () => child.kill(signal));
  child.once("error", () => { process.stderr.write("paperclip: gh could not start.\n"); process.exitCode = 1; });
  child.once("exit", (code, signal) => { process.exitCode = code === null ? 128 : code; });
}

main().catch(() => { process.stderr.write("paperclip: gh wrapper setup failed.\n"); process.exitCode = 1; });