#!/usr/bin/env node
// myrmidon(1.6.5-BOT-DISK-H3e): the executable entrypoint of the botd daemon.
// Runs with no arguments: the image entrypoint (PR #743) symlinks
// /opt/paperclip/bin/botd here and starts `botd` bare; anything else falls
// back to bot-clone-hygiene.
//
// ESM (package.json {"type":"module"}). The sibling modules are wired by
// contract: lib/classify.js (#745, classifyAll/toReportParts/toInventory),
// lib/rules.js (#742, plan; inventory {worktrees, scratch, bases, archives}),
// lib/desired.js (#740, createDesiredClient().start/getLast). A missing
// sibling means "delete nothing": desired fails closed to ok=false and the
// C4 report still goes out with the reason — the inventory is best-effort
// so the board sees the disk even when a module is absent.
//
// Env (set by the entrypoint, PR #743):
//   PAPERCLIP_API_URL / PAPERCLIP_BASE_URL — the board base URL (required)
//   PAPERCLIP_API_KEY                      — the bot API token (required)
//   PAPERCLIP_BOT_KEY                      — the bot key for the report (required)
//   PAPERCLIP_IMAGE_GENERATION             — the image generation (required)
//   BOTD_ONCE=1                            — a single pass (smoke tests)
//   BOTD_INTERVAL_MS                       — the tick period (default 60_000)
//   BOTD_WORKTREES_ROOT / _SCRATCH_ROOT / _BASES_ROOT / _ARCHIVES_ROOT / _STATE_DIR
//                                          — path overrides (tests)
//
// Logs: JSON lines to stdout; exit code 2 on a config error, 1 on a failed
// pass in BOTD_ONCE, 0 otherwise.

import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { runPass, runDaemon, defaultDeps, DEFAULT_INTERVAL_MS, REPORT_RETRY_DELAY_MS } from "./lib/loop.js";

const HERE = path.dirname(fileURLToPath(import.meta.url));

function log(level, msg, extra) {
  process.stdout.write(`${JSON.stringify({ ts: new Date().toISOString(), level, msg, ...(extra || {}) })}\n`);
}
const info = (msg, extra) => log("info", msg, extra);
const warn = (msg, extra) => log("warn", msg, extra);
const error = (msg, extra) => log("error", msg, extra);

function readEnv() {
  const env = process.env;
  const missing = [];
  const boardUrl = env.PAPERCLIP_API_URL || env.PAPERCLIP_BASE_URL || "";
  if (!boardUrl) missing.push("PAPERCLIP_API_URL");
  const apiKey = env.PAPERCLIP_API_KEY || "";
  if (!apiKey) missing.push("PAPERCLIP_API_KEY");
  const botKey = env.PAPERCLIP_BOT_KEY || env.BOTD_BOT_KEY || "";
  if (!botKey) missing.push("PAPERCLIP_BOT_KEY");
  const imageGeneration = env.PAPERCLIP_IMAGE_GENERATION || env.BOTD_IMAGE_GENERATION || "";
  if (!imageGeneration) missing.push("PAPERCLIP_IMAGE_GENERATION");
  return { boardUrl, apiKey, botKey, imageGeneration, missing };
}

async function tryImport(name) {
  try {
    return await import(`./lib/${name}.js`);
  } catch (err) {
    warn(`sibling module lib/${name}.js unavailable — degraded mode`, { error: String(err && err.message ? err.message : err) });
    return null;
  }
}

async function buildDeps(env) {
  const classify = await tryImport("classify");
  const rules = await tryImport("rules");
  const desired = await tryImport("desired");

  let desiredClient = { ok: false, reason: "lib/desired.js unavailable (#740 not merged)" };
  if (desired && typeof desired.createDesiredClient === "function") {
    desiredClient = desired.createDesiredClient({
      env: { ...process.env, PAPERCLIP_API_URL: env.boardUrl, PAPERCLIP_API_KEY: env.apiKey },
      fetchImpl: globalThis.fetch,
      log: (line) => info(line),
    });
    if (typeof desiredClient.start === "function") desiredClient.start();
  }

  const removeWorktree = classify && typeof classify.remove === "function"
    ? async (targetPath, key, action) => classify.remove({ path: targetPath, class: action.class, kind: "worktree" })
    : null;

  return { classify, rules, desiredClient, removeWorktree, archiveRemove: null, prune: null, deleteBase: null, deleteArchive: null };
}

function detectSelfChecks() {
  const checks = { reflink: null, gitref: null, wsCli: null };
  try {
    fs.accessSync("/usr/bin/cp");
    checks.reflink = true;
  } catch {
    checks.reflink = false;
  }
  try {
    fs.accessSync("/usr/bin/git");
    checks.gitref = true;
  } catch {
    checks.gitref = false;
  }
  return checks;
}

async function main() {
  const env = readEnv();
  if (env.missing.length > 0) {
    error("botd: missing required configuration", { missing: env.missing });
    process.exit(2);
  }
  const intervalMs = Number(process.env.BOTD_INTERVAL_MS || DEFAULT_INTERVAL_MS);
  const once = process.env.BOTD_ONCE === "1";
  const config = {
    board: { url: env.boardUrl.replace(/\/+$/, ""), apiKey: env.apiKey },
    identity: { botKey: env.botKey, imageGeneration: env.imageGeneration },
    roots: {
      worktreesRoot: process.env.BOTD_WORKTREES_ROOT || "/srv/dev",
      scratchRoot: process.env.BOTD_SCRATCH_ROOT || "/srv/dev/.scratch",
      basesRoot: process.env.BOTD_BASES_ROOT || "/srv/git-mirror",
      archivesRoot: process.env.BOTD_ARCHIVES_ROOT || "/srv/dev/.archives",
      scanRoots: [process.env.BOTD_WORKTREES_ROOT || "/srv/dev", process.env.BOTD_SCRATCH_ROOT || "/srv/dev/.scratch"],
    },
    stateDir: process.env.BOTD_STATE_DIR || "/var/lib/paperclip/botd",
    intervalMs,
    reportRetryDelayMs: Number(process.env.BOTD_REPORT_RETRY_DELAY_MS || REPORT_RETRY_DELAY_MS),
  };
  info("botd starting", {
    intervalMs,
    once,
    boardUrl: config.board.url,
    worktreesRoot: config.roots.worktreesRoot,
    stateDir: config.stateDir,
  });
  const wired = await buildDeps(env);
  config.selfChecks = detectSelfChecks();
  const deps = defaultDeps(wired);
  if (once) {
    const result = await runPass(config, deps);
    info("botd single pass done", {
      actions: result.actions.length,
      reportOk: result.posted.ok,
      attempts: result.posted.attempts,
    });
    process.exit(result.posted.ok ? 0 : 1);
  }
  await runDaemon(config, deps);
  info("botd stopped");
}

main().catch((err) => {
  error("botd fatal", { error: String(err && err.stack ? err.stack : err) });
  process.exit(1);
});
