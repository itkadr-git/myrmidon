#!/usr/bin/env node
"use strict";
// myrmidon(1.6.5-BOT-DISK-H3e): botd entry point (CommonJS, started by the bot
// runtime entrypoint). The main loop is lib/loop.js, the report lib/report.js; the
// other modules are loaded by their contract interfaces and replaced by inert
// stand-ins while they are absent from the image:
//   lib/desired.js  (H3a)  createDesiredClient().poll()
//   lib/rules.js    (H3b)  plan(inventory, desired, now, settings)
//   lib/classify.js (H3d)  classifyAll(), toReportParts()
//   lib/archive.js  (H3c)  optional: archive(path, key) before a scratch removal
//   lib/remove.js   (F13)  guardedRemove: ENOENT = done, EACCES/EPERM = deferred
//   lib/cache.js    (F13)  attention (one signal per path) + cooldown (the rule rhythm)
// Without desired.js nothing is ever removed (fail-safe), only reported.
//
// Usage: botd                  loop; the delay is the board's nextReportSec (300 s), +SIGUSR1
//        botd --once           one pass, then exit
//        botd --once --plan    dry run: inventory + plan as JSON on stdout, nothing executed,
//                              nothing written, no report sent

const fs = require("node:fs");
const path = require("node:path");
const os = require("node:os");
const { execFile } = require("node:child_process");

// The board writes the bot's API key and URL (and the botd settings) into the hermes
// .env, not into the container env botd inherits from the entrypoint: load the keys
// botd needs from it when they are not already set. Values are never logged.
function loadHermesEnv(file) {
  let text;
  try {
    text = fs.readFileSync(file, "utf8");
  } catch {
    return;
  }
  for (const line of text.split("\n")) {
    const m = /^\s*(?:export\s+)?([A-Z][A-Z0-9_]*)\s*=\s*(.*)$/.exec(line);
    if (!m) continue;
    const [, key, raw] = m;
    if (!/^(PAPERCLIP_API_KEY|PAPERCLIP_API_URL|MYRMIDON_[A-Z0-9_]+)$/.test(key)) continue;
    if (process.env[key] !== undefined && process.env[key] !== "") continue;
    let value = raw.trim();
    if ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'"))) value = value.slice(1, -1);
    process.env[key] = value;
  }
}
loadHermesEnv(process.env.MYRMIDON_BOTD_ENV_FILE || path.join(process.env.HERMES_HOME || "/data/hermes", ".env"));

const HOME = process.env.MYRMIDON_WS_HOME || "/data/hermes/.myrmidon";
const DISK_STATE_PATH = path.join(HOME, "disk-state.json");
const REGISTRY_PATH = path.join(HOME, "ws-registry.json");
const BASE_DIR = path.join(HOME, "git-base");
const ARCHIVE_DIR = path.join(HOME, "archive");
const ATTENTION_PATH = path.join(HOME, "botd-attention.json");
const COOLDOWN_PATH = path.join(HOME, "botd-cooldown.json");
const SCRATCH_ROOTS = ["/scratch", "/data/hermes/cache/scratch"];
const WS_BIN = process.env.MYRMIDON_WS_BIN || "myr-ws";
const GIT_BIN = process.env.MYRMIDON_BOTD_GIT || "git";

const log = (line) => process.stderr.write(`${new Date().toISOString()} ${line}\n`);

function tryImport(name) {
  const file = path.join(__dirname, "lib", name);
  if (!fs.existsSync(file)) return Promise.resolve(null);
  return import(file).catch((err) => {
    log(`botd: ${name} failed to load: ${String(err && err.message).slice(0, 200)}`);
    return null;
  });
}

function run(bin, args, timeoutMs = 120_000) {
  return new Promise((resolve) => {
    execFile(bin, args, { timeout: timeoutMs, maxBuffer: 8 * 1024 * 1024 }, (err, stdout) => {
      resolve({ code: err ? (typeof err.code === "number" ? err.code : 1) : 0, stdout: String(stdout || "") });
    });
  });
}

/** `myr-ws <args> --json`: parsed stdout; throws with the CLI's own error text on a failure. */
async function ws(args) {
  const r = await run(WS_BIN, [...args, "--json"]);
  let json = null;
  try {
    json = JSON.parse(r.stdout);
  } catch {
    /* handled below */
  }
  if (r.code !== 0 || !json || json.ok !== true) {
    throw new Error(`myr-ws ${args[0]} exit ${r.code}${json && json.error ? `: ${String(json.error).slice(0, 300)}` : ""}`);
  }
  return json;
}

function inside(root, p) {
  const rel = path.relative(root, p);
  return rel !== "" && !rel.startsWith("..") && !path.isAbsolute(rel);
}
// guardedRemove lives in lib/remove.js (imported as ESM in main): ENOENT returns
// "already gone", EACCES/EPERM throws with `deferred: "foreign-uid"` and removes
// nothing. The old inline removal is only the never-reachable stand-in while the
// import is pending; every removal runs after main() has bound the real one.
let guardedRemove = fallbackGuardedRemove;
function fallbackGuardedRemove(p, roots) {
  const abs = path.resolve(p);
  if (!roots.some((r) => inside(path.resolve(r), abs))) throw new Error("path is outside the allowed roots");
  if (fs.lstatSync(abs).isSymbolicLink()) throw new Error("refusing to remove a symlink");
  fs.rmSync(abs, { recursive: true, force: true });
}

function readJson(file, fallback) {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch {
    return fallback;
  }
}

function writeDiskState(state) {
  fs.mkdirSync(HOME, { recursive: true });
  const tmp = `${DISK_STATE_PATH}.${process.pid}.tmp`;
  fs.writeFileSync(tmp, `${JSON.stringify(state, null, 2)}\n`, { mode: 0o644 });
  fs.renameSync(tmp, DISK_STATE_PATH);
}

function listBases() {
  const out = [];
  let owners = [];
  try {
    owners = fs.readdirSync(BASE_DIR);
  } catch {
    return out;
  }
  for (const owner of owners) {
    let repos = [];
    try {
      repos = fs.readdirSync(path.join(BASE_DIR, owner));
    } catch {
      continue;
    }
    for (const r of repos) {
      if (!r.endsWith(".git")) continue;
      const p = path.join(BASE_DIR, owner, r);
      let st;
      try {
        st = fs.statSync(p);
      } catch {
        continue;
      }
      let lastFetch = null;
      try {
        lastFetch = fs.statSync(path.join(p, "FETCH_HEAD")).mtime;
      } catch {
        /* never fetched */
      }
      out.push({ repo: `${owner}/${r.slice(0, -4)}`, path: p, mtime: st.mtime, lastFetch });
    }
  }
  return out;
}

function listArchives() {
  const out = [];
  let names = [];
  try {
    names = fs.readdirSync(ARCHIVE_DIR);
  } catch {
    return out;
  }
  for (const n of names) {
    if (!n.endsWith(".bundle") && !n.endsWith(".dir.tar")) continue;
    const p = path.join(ARCHIVE_DIR, n);
    try {
      const st = fs.statSync(p);
      const m = /^(.+)-\d{8}T\d{6}Z\.(?:bundle|dir\.tar)$/.exec(n);
      out.push({ key: m ? m[1] : n, path: p, sizeBytes: st.size, createdAt: st.mtime });
    } catch {
      /* gone */
    }
  }
  return out;
}

async function main() {
  const [desiredMod, rulesMod, classifyMod, archiveMod, loopMod, reportMod, legacyMod, runsMod, removeMod, cacheMod] = await Promise.all([
    tryImport("desired.js"),
    tryImport("rules.js"),
    tryImport("classify.js"),
    tryImport("archive.js"),
    import(path.join(__dirname, "lib", "loop.js")),
    import(path.join(__dirname, "lib", "report.js")),
    import(path.join(__dirname, "lib", "legacy.js")),
    import(path.join(__dirname, "lib", "runs.js")),
    import(path.join(__dirname, "lib", "remove.js")),
    import(path.join(__dirname, "lib", "cache.js")),
  ]);
  guardedRemove = (p, roots) => removeMod.guardedRemove(p, roots);
  // One attention signal per path per TTL (botd-attention.json); the uid of the
  // owner that blocks us goes into the text. chown is never attempted here.
  const attention = cacheMod.createAttention(ATTENTION_PATH, { log });
  // The rhythm of the rules: one op on one path no more than once per TTL
  // (botd-cooldown.json); a repeat within the window is skipped without a log line.
  const cooldown = cacheMod.createCooldown(COOLDOWN_PATH);
  const runProbe = runsMod.createRunProbe({ proc: process });

  const desiredClient = desiredMod ? desiredMod.createDesiredClient({ log }) : null;
  const desired = {
    poll: () => (desiredClient ? desiredClient.poll() : Promise.resolve({ ok: false, reason: "desired module is not in this image" })),
  };
  const rules = {
    plan: (inv, state, now, settings) => (rulesMod ? rulesMod.plan(inv, state, now, settings) : { actions: [] }),
  };
  const reporter = reportMod.createReporter({ log });

  async function gather(state) {
    const registry = (readJson(REGISTRY_PATH, { entries: [] }).entries) || [];
    const bases = listBases();
    const archives = listArchives();
    let wsOk = null;
    let entries = [];
    try {
      entries = (await ws(["list"])).entries || [];
      wsOk = true;
    } catch (err) {
      wsOk = false;
      log(`botd: ${String(err.message).slice(0, 200)}`);
    }
    let classified = { items: [], actions: [] };
    let parts = { copies: [], foreign: [] };
    if (classifyMod) {
      classified = classifyMod.classifyAll({ registry, desired: state, now: Date.now() });
      parts = classifyMod.toReportParts(classified.items, classified.actions);
    }
    const nowMs = Date.now();
    const inventory = {
      worktrees: entries
        .filter((e) => e.class === "E")
        .map((e) => ({
          key: e.key,
          path: e.path,
          repo: e.repo,
          dirMissing: !fs.existsSync(e.path),
          clean: e.clean,
          pushed: e.pushed,
          openedAt: e.openedAt,
        })),
      // G (registry and legacy) and X: the rules apply TTL/grace and the activeKeys protection
      scratch: legacyMod.scratchInventory(entries, classified.items, nowMs, (p) => fs.existsSync(path.join(p, ".git"))),
      bases: bases.map((b) => ({
        path: b.path,
        repo: b.repo,
        worktreeCount: entries.filter((e) => e.class === "E" && e.repo === b.repo).length,
        lastUsedAt: (b.lastFetch || b.mtime).toISOString(),
      })),
      archives: archives.map((a) => ({ path: a.path, createdAt: a.createdAt.toISOString(), sizeBytes: a.sizeBytes })),
      // a run going now: directories with unsaved git work are kept under it (rules.js)
      run: runProbe.probe(),
    };
    parts.bases = bases.map((b) => ({ repo: b.repo, path: b.path, sizeBytes: null, lastFetchAt: b.lastFetch ? b.lastFetch.toISOString().replace(/\.\d{3}Z$/, "Z") : null }));
    parts.archives = archives.map((a) => ({ key: a.key, path: a.path, sizeBytes: a.sizeBytes, createdAt: a.createdAt.toISOString().replace(/\.\d{3}Z$/, "Z") }));
    parts.selfChecks = { reflink: null, gitref: null, wsCli: wsOk };
    return { inventory, parts };
  }

  const isWorkspace = (p) => inside("/workspace", path.resolve(p));
  const roots = ["/workspace", ...SCRATCH_ROOTS];
  // One wrapper for every removal: guardedRemove itself, plus the policy around it —
  // a deferred path (EACCES/EPERM, a foreign owner) stays exactly where it is, gets ONE
  // attention line per path per TTL (uid of the owner in the text; chown is never tried)
  // and is handed to the loop as `{ deferred }` — a skip, not an error, not a log spam.
  const removePath = (p, roots) => {
    try {
      return guardedRemove(p, roots);
    } catch (err) {
      if (err && err.deferred === "foreign-uid") {
        attention.signal(p, { reason: `${err.code} foreign-uid`, uid: err.uid });
        return { deferred: err.deferred, detail: err.message };
      }
      throw err;
    }
  };
  const owned = (p) => legacyMod.inRegistry((readJson(REGISTRY_PATH, { entries: [] }).entries) || [], p);
  // A path under /workspace that the registry does not list (an old clone, a task directory
  // from before myr-ws): `myr-ws close` would fail with "no open copy", so archive it here.
  const legacyRemove = (a) =>
    legacyMod.archiveThenRemove(a, {
      archiveMod,
      isGit: (p) => fs.existsSync(path.join(p, ".git")),
      remove: (p) => removePath(p, roots),
      archiveRoot: ARCHIVE_DIR,
      nestedGit: legacyMod.findNestedGit,
    });
  const executor = {
    // E: the CLI owns worktree removal and the archive; G: files under a scratch root
    remove: async (a) => {
      if (isWorkspace(a.path)) {
        if (!owned(a.path)) return legacyRemove(a);
        const force = /pr-merged/.test(a.reason || "");
        const r = await ws(["close", a.key, ...(force ? ["--force"] : [])]);
        return r.archived ? `archived to ${r.archivePath || "archive"}` : "closed";
      }
      // a scratch directory holding repositories is archived like a legacy one
      if (legacyMod.findNestedGit(a.path).length > 0) {
        return legacyMod.archiveThenRemove(a, {
          archiveMod,
          isGit: (p) => fs.existsSync(path.join(p, ".git")),
          remove: (p) => removePath(p, SCRATCH_ROOTS),
          archiveRoot: ARCHIVE_DIR,
          nestedGit: legacyMod.findNestedGit,
        });
      }
      return removePath(a.path, SCRATCH_ROOTS);
    },
    "archive-remove": async (a) => {
      if (isWorkspace(a.path)) {
        if (!owned(a.path)) return legacyRemove(a);
        const r = await ws(["close", a.key, "--force"]);
        return r.archived ? `archived to ${r.archivePath || "archive"}` : "closed";
      }
      return legacyMod.archiveThenRemove(a, {
        archiveMod,
        isGit: (p) => fs.existsSync(path.join(p, ".git")),
        remove: (p) => removePath(p, SCRATCH_ROOTS),
        archiveRoot: ARCHIVE_DIR,
        nestedGit: legacyMod.findNestedGit,
      });
    },
    prune: async () => {
      for (const b of listBases()) await run(GIT_BIN, ["--git-dir", b.path, "worktree", "prune"]);
      return "worktree prune";
    },
    "delete-base": async (a) => removePath(a.path, [BASE_DIR]),
    "delete-archive": async (a) => removePath(a.path, [ARCHIVE_DIR]),
  };

  const loop = loopMod.createLoop({
    desired,
    rules,
    gather,
    executor,
    cooldown,
    report: { build: reportMod.buildReport, send: reporter.send },
    writeDiskState,
    log,
    botKey: process.env.MYRMIDON_BOT_KEY || process.env.MYRMIDON_BOT_SCOPE_SUBDIR || os.hostname(),
    imageGeneration: process.env.MYRMIDON_IMAGE_GENERATION || process.env.MYRMIDON_IMAGE_TAG || "unknown",
  });

  if (process.argv.includes("--once") && process.argv.includes("--plan")) {
    const r = await loop.runOnce({ dryRun: true });
    const byOp = {};
    for (const a of (r.planned && r.planned.actions) || []) byOp[a.op] = (byOp[a.op] || 0) + 1;
    process.stdout.write(
      `${JSON.stringify({
        desiredOk: r.desiredOk,
        pressure: (r.planned && r.planned.pressure) || null,
        actions: (r.planned && r.planned.actions) || [],
        held: (r.planned && r.planned.held) || [],
        summary: { byOp },
        notes: r.results.filter((x) => x.result === "skipped" && x.path === "/").map((x) => x.detail),
      })}\n`,
    );
    return;
  }
  if (process.argv.includes("--once")) {
    const r = await loop.runOnce();
    log(`botd: pass done, desired ${r.desiredOk ? "ok" : "unavailable"}, actions ${r.executed.length}, report ${r.sent.ok ? "sent" : `not sent (${r.sent.reason})`}`);
    return;
  }
  loop.start(process);
  const bye = () => {
    void loop.stop().finally(() => process.exit(0));
  };
  process.on("SIGTERM", bye);
  process.on("SIGINT", bye);
}

main().catch((err) => {
  log(`botd: fatal: ${String(err && err.message).slice(0, 300)}`);
  process.exit(1);
});
