#!/usr/bin/env node
// docker/bot-runtime/build-wrappers/vitest
//
// myrmidon(1.6.1 BUILD-OFFLOAD A): vitest wrapper for the dev variant.
// The repository's test suites are heavy (workspace installs, embedded
// databases, parallel workers) and must run on the build VPS through
// `devbuild vitest ...`. Like tsc, the real vitest binary is installed
// by the repository's own `pnpm install` into the workspace, so the
// wrapper resolves it from PATH minus its own directory; see tsc's
// comment for the two-world behaviour. Gate mechanics: blocked-tool.js.
//
// CJS on purpose (see devbuild-gate.js): in the image this file lives
// at /opt/paperclip/bin/, which no package.json reaches.
"use strict";

const fs = require("node:fs");
const path = require("node:path");
const { makeWrapper } = require("./blocked-tool.js");

const SELF_DIR = path.dirname(fs.realpathSync(process.argv[1]));

function resolveReal() {
  const pathEnv = (process.env.PATH || "").split(path.delimiter).filter(Boolean);
  for (const dir of pathEnv) {
    const candidate = path.join(dir, "vitest");
    let real;
    try {
      real = fs.realpathSync(candidate);
    } catch {
      continue;
    }
    if (path.dirname(real) !== SELF_DIR) return candidate;
  }
  return null;
}

const real = resolveReal();
if (real) {
  makeWrapper("vitest", real)();
} else {
  process.stderr.write(
    [
      "vitest: heavy build operations are blocked inside the bot container (1.6.1 BUILD-OFFLOAD).",
      "The test runner is not installed in this container, and the repository's test suites",
      "must run on the build VPS. Instead run:  devbuild vitest run",
    ].join("\n") + "\n",
  );
  process.exitCode = 1;
}
