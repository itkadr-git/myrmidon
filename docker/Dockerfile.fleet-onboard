# syntax=docker/dockerfile:1.20
#
# fleet-onboard executor: isolated runner for server SSH hardening and bootstrap.
# Does NOT require host mounts (/var/run/docker.sock or host filesystem).
# Communicates with board API over HTTP and target server over SSH.

FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       openssh-client \
       ca-certificates \
       curl \
       tini \
  && rm -rf /var/lib/apt/lists/*

USER node
WORKDIR /home/node

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "-e", "console.log('myrmidon fleet-onboard executor ready')"]
